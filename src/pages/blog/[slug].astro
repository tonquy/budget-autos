---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImageBand from '../../components/ImageBand.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { business, services } from '../../lib/business';
import { blogHeroImages, formatBlogDate } from '../../lib/blog';
import { articleJsonLd, breadcrumbJsonLd, faqJsonLd } from '../../lib/seo';
import bgCta from '../../assets/images/bg-cta-dark.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

export const prerender = true;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const path = `/blog/${post.id}/`;
const heroImage = blogHeroImages[post.data.hero];
const published = post.data.updatedDate ?? post.data.pubDate;

const service = services.find(item => item.slug === post.data.service);
const cta = post.data.cta ?? (service
  ? { label: `Request ${service.name.toLowerCase()}`, href: `/quote/${service.slug}/` }
  : { label: 'Request service', href: '/quote/' });
const related = post.data.category
  ? (await getCollection('blog')).filter(item => item.id !== post.id && item.data.category === post.data.category).slice(0, 3)
  : [];
const contents = headings.filter(heading => heading.depth === 2);

const jsonLd = [
  breadcrumbJsonLd(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'Repair Help', path: '/blog/' },
    { name: post.data.title, path },
  ]),
  articleJsonLd(siteUrl, {
    title: post.data.title,
    description: post.data.description,
    path,
    datePublished: post.data.pubDate,
    dateModified: published,
  }),
  faqJsonLd(post.data.faqs),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate}
  jsonLd={jsonLd}
>
  <PageHero
    image={heroImage}
    alt={post.data.heroAlt}
    title={post.data.title}
    description={post.data.description}
    size="default"
    priority
  >
    <nav slot="breadcrumb" aria-label="Breadcrumb" class="mb-4 text-sm text-steel-300">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-white">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/blog/" class="hover:text-white">Repair Help</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-white" aria-current="page">Article</li>
      </ol>
    </nav>
    <a
      slot="actions"
      href={cta.href}
      data-contact-action="quote"
      data-contact-location="blog-hero"
      class="btn btn-primary"
    >
      <Icon name="clipboard-check" class="size-4 shrink-0" />
      {cta.label}
    </a>
    <a
      slot="actions"
      href={`sms:${business.smsNumber}`}
      data-sms-link
      data-sms-number={business.smsNumber}
      data-sms-body={business.smsBody}
      data-contact-action="text"
      data-contact-location="blog-hero"
      class="btn btn-on-dark"
    >
      Text {business.phoneDisplay}
    </a>
  </PageHero>

  <div class="bg-paper py-14 sm:py-20">
    <div class="container-shop grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-16">
      <article>
        <p class="text-sm text-steel-700">
          {post.data.updatedDate ? 'Updated ' : ''}{formatBlogDate(published)}
          <span class="text-steel-300"> / </span>
          {business.name}, {business.address.city}
        </p>
        <div class="blog-prose mt-8 max-w-[70ch]">
          <Content />
        </div>
      </article>

      <aside
        class="rounded-card border border-black/5 bg-surface p-5 shadow-card lg:sticky lg:top-24"
        aria-label="Shop contact"
      >
        {contents.length > 0 && <nav aria-label="In this guide" class="mb-7 border-b border-black/10 pb-6">
          <h2 class="font-display text-lg font-semibold text-ink">In this guide</h2>
          <ul class="mt-3 space-y-1">{contents.map(heading => <li><a href={`#${heading.slug}`} class="block py-2 text-sm leading-relaxed text-accent-dark hover:underline">{heading.text}</a></li>)}</ul>
        </nav>}
        <p class="font-display text-lg font-semibold tracking-tight text-ink">Talk to the shop</p>
        <a href={cta.href} class="btn btn-primary mt-4 w-full" data-contact-action="quote" data-contact-location="blog-aside">{cta.label}</a>
        {service && <a href={`/services/${service.slug}/`} class="mt-3 block py-2 text-sm font-semibold text-accent-dark hover:underline">About {service.name.toLowerCase()}</a>}
        <p class="mt-2 text-sm leading-relaxed text-steel-700">
          {business.address.line1}, {business.address.city}. Tell us the symptoms and ask about inspection availability and charges.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-steel-700">
          {business.hours.map((row) => (
            <li class="flex justify-between gap-3">
              <span>{row.day}</span>
              <span class="text-steel-500">{row.time}</span>
            </li>
          ))}
        </ul>
        <a
          href={business.phoneHref}
          data-contact-action="call"
          data-contact-location="blog-aside"
          class="mt-5 flex items-center gap-2 text-sm font-semibold text-accent-dark hover:text-accent"
        >
          <Icon name="phone" class="size-4" />
          Call {business.phoneDisplay}
        </a>
        <a
          href={`sms:${business.smsNumber}`}
          data-sms-link
          data-sms-number={business.smsNumber}
          data-sms-body={business.smsBody}
          data-contact-action="text"
          data-contact-location="blog-aside"
          class="mt-2 flex items-center gap-2 text-sm font-semibold text-accent-dark hover:text-accent"
        >
          <Icon name="message-square" class="size-4" />
          Text us
        </a>
      </aside>
    </div>
  </div>

  <section class="border-t border-black/5 bg-surface py-16 sm:py-20">
    <div class="container-shop max-w-3xl">
      <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Common questions
      </h2>
      <dl class="mt-8 divide-y divide-black/5">
        {post.data.faqs.map((faq) => (
          <div class="py-5 first:pt-0 last:pb-0">
            <dt class="font-display text-lg font-semibold text-ink">{faq.question}</dt>
            <dd class="mt-2 leading-relaxed text-steel-700">{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {related.length > 0 && <section class="border-t border-black/10 bg-paper py-12 sm:py-16">
    <div class="container-shop max-w-3xl">
      <h2 class="font-display text-2xl font-bold">Related repair questions</h2>
      <ul class="mt-5 divide-y divide-black/10">{related.map(item => <li><a class="block py-4 font-medium text-accent-dark hover:underline" href={`/blog/${item.id}/`}>{item.data.title}</a></li>)}</ul>
      <a href="/blog/" class="mt-5 inline-flex min-h-11 items-center font-semibold text-accent-dark hover:underline">All repair questions</a>
    </div>
  </section>}

  <ImageBand image={bgCta} alt="Close-up of precision auto repair work under warm shop lights">
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
      {post.data.category === 'transport' ? 'Plan transportation for your repair.' : 'Get help with your next step.'}
    </h2>
    <p class="mt-2 text-steel-300">
      {post.data.category === 'transport' ? 'Send a rental request and confirm availability with the shop before arranging your drop-off.' : 'Tell us what is happening or send an existing estimate. We will explain what needs checking before recommending work.'}
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <a
        href={cta.href}
        data-contact-action="quote"
        data-contact-location="blog-band"
        class="btn btn-primary"
      >
        <Icon name="clipboard-check" class="size-4 shrink-0" />
        {cta.label}
      </a>
      <a
        href={`sms:${business.smsNumber}`}
        data-sms-link
        data-sms-number={business.smsNumber}
        data-sms-body={business.smsBody}
        data-contact-action="text"
        data-contact-location="blog-band"
        class="btn btn-on-dark"
      >
        <Icon name="message-square" class="size-4 shrink-0" />
        Text {business.phoneDisplay}
      </a>
    </div>
    <p class="mt-6 text-sm leading-relaxed text-steel-500">{business.laborGuide}</p>
  </ImageBand>
</BaseLayout>
