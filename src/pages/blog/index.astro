---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { business } from '../../lib/business';
import { formatBlogDate } from '../../lib/blog';
import { breadcrumbJsonLd } from '../../lib/seo';
import heroQuote from '../../assets/images/hero-quote.jpg';

export const prerender = true;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
---

<BaseLayout
  title="Repair guides for Binghamton drivers"
  description={`Photo quotes, drop-off, and straight answers from ${business.name} in ${business.address.city}. Start with how to get a car repair quote online.`}
  jsonLd={[
    breadcrumbJsonLd(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Questions', path: '/blog' },
    ]),
  ]}
>
  <PageHero
    image={heroQuote}
    alt={`Service bay at ${business.name} in ${business.address.city}`}
    title="Repair guides from the shop"
    description="How we quote work, what to photograph, and how to get a car onto Airport Rd."
    size="compact"
    priority
  >
    <nav slot="breadcrumb" aria-label="Breadcrumb" class="mb-4 text-sm text-steel-300">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-white">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-white" aria-current="page">Questions</li>
      </ol>
    </nav>
  </PageHero>

  <section class="bg-paper py-14 sm:py-20">
    <div class="container-shop max-w-3xl">
      <ul class="divide-y divide-black/5">
        {posts.map((post) => (
          <li class="py-8 first:pt-0 last:pb-0">
            <p class="text-sm text-steel-500">{formatBlogDate(post.data.pubDate)}</p>
            <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
              <a href={`/blog/${post.id}`} class="hover:text-accent-dark">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-3 max-w-[65ch] leading-relaxed text-steel-700">{post.data.description}</p>
            <p class="mt-4">
              <a
                href={`/blog/${post.id}`}
                class="text-sm font-semibold text-accent hover:text-accent-dark"
              >
                Read the guide
              </a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
