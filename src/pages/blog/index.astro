---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { breadcrumbJsonLd } from '../../lib/seo';
import { repairQuestionGroups } from '../../lib/repairQuestions';
import heroQuote from '../../assets/images/hero-quote.jpg';

export const prerender = true;
const otherPosts = (await getCollection('blog')).filter(post => !post.data.category).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
---
<BaseLayout title="Car repair questions & second opinions in Johnson City, NY" description="Start with your car problem: repair estimates, check-engine lights, no-starts, brake noise, tire wear, or repair-versus-replace decisions. Help from Budget Autos Repair." jsonLd={[breadcrumbJsonLd(siteUrl, [{ name: 'Home', path: '/' }, { name: 'Repair Help', path: '/blog/' }])]}>
  <PageHero image={heroQuote} alt="Vehicle and repair details" title="What’s happening with your car?" description="Start with the question on your mind. Practical repair guides from Budget Autos Repair in Johnson City, serving Binghamton and nearby communities." size="compact" priority />
  <section class="border-b border-black/10 bg-surface py-8 sm:py-10">
    <div class="container-shop flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center">
      <div><h2 class="font-display text-xl font-semibold sm:text-2xl">Already have a repair estimate?</h2><p class="mt-2 max-w-xl leading-relaxed text-steel-700">Send the paperwork and get help understanding the recommended work.</p></div>
      <a href="/second-opinion/" class="btn btn-primary shrink-0" data-contact-action="quote" data-contact-location="repair-help-index">Get a second opinion</a>
    </div>
  </section>
  <section class="bg-paper py-12 sm:py-16" aria-label="Repair questions by topic">
    <div class="container-shop grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16">
      <nav aria-label="Repair topics" class="self-start lg:sticky lg:top-24">
        <h2 class="font-display text-lg font-semibold">Find your question</h2>
        <ul class="mt-3 flex flex-wrap gap-x-5 lg:block">{repairQuestionGroups.map(group => <li><a href={`#${group.id}`} class="inline-flex min-h-11 items-center text-sm font-medium text-accent-dark hover:underline">{group.title}</a></li>)}</ul>
      </nav>
      <div class="min-w-0 space-y-12 sm:space-y-16">
        {repairQuestionGroups.map(group => (
          <section id={group.id} class="scroll-mt-24" aria-labelledby={`${group.id}-title`}>
            <h2 id={`${group.id}-title`} class="font-display text-2xl font-bold tracking-tight sm:text-3xl">{group.title}</h2>
            <p class="mt-2 leading-relaxed text-steel-700">{group.description}</p>
            <ul class="mt-5 divide-y divide-black/10 border-y border-black/10">{group.questions.map(item => <li><a href={item.href} class="flex min-h-16 items-center justify-between gap-5 py-4 font-medium leading-relaxed text-ink hover:text-accent-dark"><span>{item.question}</span><Icon name="arrow-up-right" class="size-5 shrink-0 text-accent-dark" /></a></li>)}</ul>
          </section>
        ))}
      </div>
    </div>
  </section>
  <section class="border-t border-black/10 bg-surface py-12 sm:py-16">
    <div class="container-shop max-w-3xl">
      <h2 class="font-display text-2xl font-bold">More about choosing a shop & requesting service</h2>
      <ul class="mt-6 divide-y divide-black/10">{otherPosts.map(post => <li><a href={`/blog/${post.id}/`} class="inline-flex min-h-12 items-center py-3 font-medium text-accent-dark hover:underline">{post.data.title}</a></li>)}</ul>
    </div>
  </section>
</BaseLayout>
