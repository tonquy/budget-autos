---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import ImageBand from '../../components/ImageBand.astro';
import { business, services, type Service } from '../../lib/business';
import { serviceImages } from '../../lib/serviceImages';
import { breadcrumbJsonLd, faqJsonLd, serviceJsonLd } from '../../lib/seo';
import bgCta from '../../assets/images/bg-cta-dark.jpg';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

export const prerender = true;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const image = serviceImages[service.slug];
// GBP service names that fall under this landing page, if any.

const jsonLd = [
  breadcrumbJsonLd(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: service.name, path: `/services/${service.slug}/` },
  ]),
  serviceJsonLd(siteUrl, service),
  faqJsonLd(service.faqs),
];
---

<BaseLayout
  title={`${service.name} in ${business.address.city}, ${business.address.state}`}
  description={service.seoDescription}
  jsonLd={jsonLd}
>
  <PageHero
    image={image}
    alt={`${service.name} at ${business.name} in ${business.address.city}, ${business.address.state}`}
    eyebrow={`${business.address.city}, ${business.address.state}`}
    title={service.name}
    description={service.description}
    priority
  >
    <nav slot="breadcrumb" aria-label="Breadcrumb" class="mb-4 text-sm text-steel-300">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-white">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/services/" class="hover:text-white">Services</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-white" aria-current="page">{service.name}</li>
      </ol>
    </nav>
    <a
      slot="actions"
      href={`/book/?service=${service.slug}`}
      data-contact-action="schedule"
      data-contact-location="service-hero"
      class="btn btn-primary"
    >
      <Icon name="calendar-check" class="size-4 shrink-0" />
      Schedule Appointment
    </a>
    <button
      slot="actions"
      type="button"
      data-open-chat
      class="btn btn-on-dark"
    >
      Chat with us
    </button>
  </PageHero>


  <section class="bg-paper py-16 sm:py-20">
    <div class="container-shop max-w-3xl">
      <ul class="space-y-3">
        {service.highlights.map((item) => (
          <li class="flex items-start gap-3 text-ink">
            <Icon name="circle-check-big" class="mt-0.5 size-5 shrink-0 text-accent" />
            <span class="leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>


    </div>
  </section>

  <section class="border-t border-black/5 bg-surface py-16 sm:py-20">
    <div class="container-shop max-w-3xl">
      <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Common questions
      </h2>
      <div class="mt-5 divide-y divide-black/10">
        {service.faqs.map((faq) => (
          <details class="py-4">
            <summary class="cursor-pointer font-display text-lg font-semibold text-ink">{faq.question}</summary>
            <p class="mt-2 leading-relaxed text-steel-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ImageBand image={bgCta} alt="Close-up of precision auto repair work under warm shop lights">
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
      Ready to get it fixed?
    </h2>
    <p class="mt-2 text-steel-300">
      Book a time that works and we&rsquo;ll have the bay ready. Need it sooner than the calendar
      shows, or not sure it&rsquo;s safe to drive? Call or text us and we&rsquo;ll sort it out.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <a
        href={`/book/?service=${service.slug}`}
        data-contact-action="schedule"
        data-contact-location="service-band"
        class="btn btn-primary"
      >
        <Icon name="calendar-check" class="size-4 shrink-0" />
        Schedule Appointment
      </a>
      <a
        href={business.phoneHref}
        data-contact-action="call"
        data-contact-location="service-band"
        class="btn btn-on-dark"
      >
        <Icon name="phone" class="size-4 shrink-0" />
        Call {business.phoneDisplay}
      </a>
    </div>
    <p class="mt-6 text-sm leading-relaxed text-steel-500">{business.laborGuide}</p>
  </ImageBand>
</BaseLayout>
