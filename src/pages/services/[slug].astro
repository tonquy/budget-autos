---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import ContactActions from '../../components/ContactActions.astro';
import { business, services, type Service } from '../../lib/business';
import { landingServices } from '../../lib/serviceDefinitions';
import { serviceDetails } from '../../lib/serviceDetails';
import { serviceMedia } from '../../lib/serviceMedia';
import { breadcrumbJsonLd, serviceJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return landingServices.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
export const prerender = true;
interface Props { service: Service }
const { service } = Astro.props;
const detail = serviceDetails[service.slug];
const media = serviceMedia[service.slug];
if (!media) throw new Error(`Missing service media: ${service.slug}`);
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const bookable = services.some((item) => item.slug === service.slug);
const requestHref = `/quote/${service.slug}/`;
const actionHref = bookable ? `/book/?service=${service.slug}` : requestHref;
const actionText = bookable ? 'Schedule Appointment' : 'Get a Free Quote';
const actionKind = bookable ? 'schedule' : 'request';
const relatedServices = detail.related.map((slug) => landingServices.find((item) => item.slug === slug)!);
const shareImage = await getImage({ src: media.hero, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const jsonLd = [
  breadcrumbJsonLd(siteUrl, [
    { name: 'Home', path: '/' }, { name: 'Services', path: '/services/' },
    { name: service.name, path: `/services/${service.slug}/` },
  ]),
  { ...serviceJsonLd(siteUrl, service), image: new URL(shareImage.src, siteUrl).href },
];
---

<BaseLayout title={`${service.name} in ${business.address.city}, ${business.address.state}`}
  description={service.seoDescription} image={shareImage.src} imageWidth={1200} imageHeight={630}
  imageAlt={media.heroAlt} jsonLd={jsonLd}>
  <PageHero image={media.hero} alt={media.heroAlt} eyebrow="Johnson City, NY · Budget Autos Repair"
    title={service.name} description={service.description} priority>
    <nav slot="breadcrumb" aria-label="Breadcrumb" class="mb-5 text-xs text-steel-200 sm:text-sm">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <li><a href="/" class="hover:text-white">Home</a></li><li aria-hidden="true">/</li>
        <li><a href="/services/" class="hover:text-white">Services</a></li><li aria-hidden="true">/</li>
        <li aria-current="page">{service.name}</li>
      </ol>
    </nav>
    <a slot="actions" href={actionHref} data-contact-action={actionKind} data-contact-location="service-hero" class="btn btn-primary">
      <Icon name={bookable ? 'calendar-check' : 'clipboard-list'} class="size-4 shrink-0" />{actionText}
    </a>
    <a slot="actions" href={business.phoneHref} data-contact-action="call" data-contact-location="service-hero" class="btn btn-on-dark">
      <Icon name="phone" class="size-4 shrink-0" />Call {business.phoneDisplay}
    </a>
  </PageHero>

  <nav aria-label="On this service page" class="service-jump border-b border-black/10 bg-surface">
    <div class="container-shop flex flex-wrap gap-x-6 gap-y-1 py-3 text-sm font-medium">
      <a href="#overview">Overview</a><a href="#what-we-check">Service details</a>
      <a href="#your-visit">Your visit</a><a href="#cost-and-timing">Cost & timing</a><a href="#service-faq">FAQs</a>
    </div>
  </nav>

  <section id="overview" class="service-section bg-paper">
    <div class="container-shop grid gap-10 lg:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)] lg:gap-20">
      <div data-reveal>
        <p class="service-kicker">A clear place to start</p>
        <h2 class="service-heading">{detail.heading}</h2>
        <div class="service-copy mt-5 space-y-4">{detail.intro.map((paragraph) => <p>{paragraph}</p>)}</div>
      </div>
      <aside class="service-help self-start rounded-card border border-black/10 bg-surface p-6 sm:p-7" aria-label="Contact the shop" data-reveal>
        <Icon name={service.icon} class="mb-5 size-8 text-accent" />
        <h2 class="font-display text-xl font-semibold">Tell us what your car needs.</h2>
        <p class="mt-3 text-sm leading-relaxed text-steel-700">Send the year, make, model, and what you’re noticing. A photo or short video can help us plan the next step.</p>
        <a href={requestHref} data-contact-action="request" data-contact-location="service-overview" class="btn btn-primary mt-5 w-full">Get a Free Quote<Icon name="arrow-up-right" class="size-4" /></a>
        <p class="mt-5 border-t border-black/10 pt-4 text-sm leading-relaxed text-steel-700">
          <strong class="font-semibold text-ink">{business.address.line1}</strong><br />Johnson City, NY {business.address.zip}<br />Mon–Fri, 9 AM–5 PM · Saturday by appointment
        </p>
      </aside>
    </div>
  </section>

  <section class="service-section border-t border-black/10 bg-surface" aria-labelledby="signs-heading">
    <div class="container-shop">
      <div class="max-w-2xl" data-reveal><p class="service-kicker">What you might notice</p><h2 id="signs-heading" class="service-heading">When to have it checked</h2></div>
      <div class="mt-8 grid gap-x-10 gap-y-7 sm:grid-cols-2" data-reveal="stagger">
        {detail.signs.map((sign) => <div class="border-t border-black/15 pt-5"><h3 class="font-display text-lg font-semibold">{sign.title}</h3><p class="service-copy mt-2">{sign.text}</p></div>)}
      </div>
      {detail.caution && <aside class="mt-8 border-l-2 border-accent bg-paper px-5 py-4"><h3 class="font-display font-semibold">{detail.caution.title}</h3><p class="mt-1 text-sm leading-relaxed text-steel-700">{detail.caution.text}</p></aside>}
    </div>
  </section>

  <section id="what-we-check" class="service-section bg-paper">
    <div class="container-shop grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="service-kicker">Service details</p><h2 class="service-heading">What the work can include</h2>
        <div class="mt-7 divide-y divide-black/10">
          {detail.included.map((item, index) => <div class="flex gap-4 py-5 first:pt-0"><span class="mt-1 font-display text-xs font-semibold text-accent-dark" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3 class="font-display text-lg font-semibold">{item.title}</h3><p class="service-copy mt-2">{item.text}</p></div></div>)}
        </div>
      </div>
      <figure class="service-detail-figure lg:sticky lg:top-28" data-reveal>
        <Image src={media.detail} alt={media.detailAlt} widths={[480, 768, 1100]} sizes="(min-width: 1024px) 45vw, 100vw" quality={78} class="aspect-[4/3] w-full rounded-card object-cover" loading="lazy" />
        <figcaption class="mt-3 text-xs leading-relaxed text-steel-700">{media.caption}</figcaption>
        <div class="mt-6 border-t border-black/15 pt-5"><h3 class="font-display text-lg font-semibold">{detail.decisions.heading}</h3><div class="service-copy mt-3 space-y-3">{detail.decisions.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div>
      </figure>
    </div>
  </section>

  {media.gallery && <section class="service-section border-t border-black/10 bg-surface" aria-labelledby="gallery-heading">
    <div class="container-shop">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div><p class="service-kicker">A closer look</p><h2 id="gallery-heading" class="service-heading">What the work involves</h2></div>
        <a href={requestHref} data-contact-action="request" data-contact-location="service-gallery" class="btn btn-primary">Get a Free Quote<Icon name="arrow-up-right" class="size-4" /></a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2" data-reveal="stagger">
        {media.gallery.map((item) => <figure><Image src={item.src} alt={item.alt} widths={[480, 768, 1100]} sizes="(min-width: 640px) 45vw, 100vw" quality={78} class="aspect-[16/10] w-full rounded-card object-cover" loading="lazy" /></figure>)}
      </div>
      <p class="mt-3 text-xs leading-relaxed text-steel-700">Service illustrations.</p>
    </div>
  </section>}

  {(media.video || media.caseStudy) && <section class="service-section border-y border-white/10 bg-ink text-white" aria-labelledby="workshop-heading">
    <div class:list={['container-shop grid gap-10 lg:gap-16', media.video && 'lg:grid-cols-[minmax(0,1fr)_minmax(0,0.6fr)]']}>
      <div data-reveal>
        <p class="service-kicker text-accent">From our workshop</p>
        <h2 id="workshop-heading" class="service-heading text-white">{media.caseStudy?.title ?? 'A closer look at the work'}</h2>
        {media.caseStudy && <><p class="mt-5 max-w-2xl text-base leading-relaxed text-steel-200">{media.caseStudy.text}</p>
          <div class="mt-7 grid grid-cols-2 gap-4">{media.caseStudy.images.map((item) => <figure><Image src={item.src} alt={item.alt} widths={[320, 640]} sizes="(min-width: 1024px) 26vw, 45vw" class="aspect-[4/3] w-full rounded-card object-cover" loading="lazy" /><figcaption class="mt-2 text-xs leading-relaxed text-steel-300">{item.caption}</figcaption></figure>)}</div></>}
        {media.video && <p class="mt-5 max-w-xl text-sm leading-relaxed text-steel-300">{media.video.caption} The clip is silent; use the player controls to watch.</p>}
      </div>
      {media.video && <figure class="mx-auto w-full max-w-xs self-center" data-reveal>
        <video controls muted playsinline preload="none" poster={media.video.poster} width="720" height="1280" class="max-h-[30rem] w-full rounded-card bg-black object-contain" aria-label={media.video.caption}>
          <source src={media.video.src} type="video/mp4" />
          Your browser does not support this video. <a href={media.video.src}>Watch the workshop clip.</a>
        </video>
        <figcaption class="mt-3 text-xs text-steel-300">Actual footage from Budget Autos Repair.</figcaption>
      </figure>}
    </div>
  </section>}

  <section id="your-visit" class="service-section bg-surface">
    <div class="container-shop">
      <div data-reveal><p class="service-kicker">From the first visit to the next step</p><h2 class="service-heading">What to expect</h2></div>
      <ol class="mt-9 grid gap-8 md:grid-cols-3" data-reveal="stagger">{detail.process.map((step, index) => <li class="border-t-2 border-accent pt-5"><span class="font-display text-sm text-accent-dark">0{index + 1}</span><h3 class="mt-3 font-display text-xl font-semibold">{step.title}</h3><p class="service-copy mt-3">{step.text}</p></li>)}</ol>
    </div>
  </section>

  <section id="cost-and-timing" class="service-section border-y border-black/10 bg-paper">
    <div class="container-shop grid gap-10 lg:grid-cols-2 lg:gap-20">
      <div data-reveal><p class="service-kicker">Plan the repair</p><h2 class="service-heading">Cost & timing</h2><p class="service-copy mt-5">{detail.cost.text}</p>
        <ul class="service-list mt-5">{detail.cost.factors.map((factor) => <li><Icon name="circle-check-big" class="mt-1 size-4 shrink-0 text-accent-dark" /><span>{factor}</span></li>)}</ul>
        <p class="mt-5 text-xs leading-relaxed text-steel-700">{business.laborGuide} Ask about any inspection or diagnostic charge when arranging your visit.</p>
      </div>
      <div class="border-t border-black/15 pt-7 lg:border-t-0 lg:border-l lg:pl-12 lg:pt-0" data-reveal><p class="service-kicker">Before you arrive</p><h2 class="service-heading">Help us get a clear picture.</h2><ul class="service-list mt-5">{detail.preparation.map((item) => <li><Icon name="chevron-right" class="mt-1 size-4 shrink-0 text-accent-dark" /><span>{item}</span></li>)}</ul>
        <a href={requestHref} data-contact-action="request" data-contact-location="service-preparation" class="mt-7 inline-flex min-h-11 items-center gap-2 font-semibold text-accent-dark underline decoration-accent/30 underline-offset-4">Send your vehicle details<Icon name="arrow-up-right" class="size-4" /></a>
      </div>
    </div>
  </section>

  <section id="service-faq" class="service-section bg-surface">
    <div class="container-shop grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div data-reveal><p class="service-kicker">Good questions. Clear answers.</p><h2 class="service-heading">Before you book</h2><p class="service-copy mt-4">Have a question about your particular vehicle? <a href={business.phoneHref} class="font-medium text-accent-dark underline underline-offset-4">Call {business.phoneDisplay}</a>.</p></div>
      <div class="divide-y divide-black/15 border-y border-black/15">{detail.faqs.map((faq) => <details class="service-faq py-5"><summary class="flex cursor-pointer items-start justify-between gap-4 font-display text-base font-semibold sm:text-lg"><span>{faq.question}</span><Icon name="plus" class="faq-icon mt-1 size-4 shrink-0 text-accent-dark" /></summary><p class="service-copy mt-4 pr-5">{faq.answer}</p></details>)}</div>
    </div>
  </section>

  <section class="service-section border-t border-black/10 bg-paper" aria-labelledby="related-heading">
    <div class="container-shop grid gap-10 lg:grid-cols-2 lg:gap-20">
      <div><p class="service-kicker">Keep exploring</p><h2 id="related-heading" class="service-heading">Related services</h2><div class="mt-6 divide-y divide-black/15 border-y border-black/15">{relatedServices.map((related) => <a href={`/services/${related.slug}/`} class="service-related group flex min-h-16 items-center justify-between gap-4 py-4 font-display text-lg font-semibold"><span>{related.name}</span><Icon name="arrow-up-right" class="size-5 shrink-0 text-accent-dark transition-transform group-hover:translate-x-1" /></a>)}</div></div>
      <div><p class="service-kicker">Useful reading</p><h2 class="service-heading">Understand the symptoms.</h2><div class="mt-6 divide-y divide-black/15 border-y border-black/15">{detail.articles.map((article) => <a href={article.href} class="service-related group flex min-h-16 items-center justify-between gap-4 py-4 text-base font-medium"><span>{article.title}</span><Icon name="arrow-up-right" class="size-5 shrink-0 text-accent-dark transition-transform group-hover:translate-x-1" /></a>)}</div><a href="/services/" class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-accent-dark underline underline-offset-4">View all {landingServices.length} service categories</a></div>
    </div>
  </section>

  <section class="service-section bg-ink text-white">
    <div class="container-shop grid items-center gap-8 md:grid-cols-[1.2fr_1fr] md:gap-16" data-reveal>
      <div><p class="service-kicker text-accent">Your local shop on Airport Road</p><h2 class="service-heading text-white">Let’s work out the next step.</h2><p class="mt-4 max-w-xl leading-relaxed text-steel-200">For drivers in Johnson City, Binghamton, Endicott, and the surrounding Broome County area. Tell us what’s happening and we’ll help you plan a visit.</p></div>
      <div><a href={actionHref} data-contact-action={actionKind} data-contact-location="service-footer" class="btn btn-primary w-full">{actionText}<Icon name="arrow-up-right" class="size-4" /></a><ContactActions tone="dark" location="service-footer" class="mt-3" /><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(business.mapsQuery)}`} class="mt-5 flex min-h-11 items-center justify-center gap-2 text-sm text-steel-200 underline underline-offset-4"><Icon name="map-pin" class="size-4 shrink-0" />2344 Airport Rd, Johnson City</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-section { padding-block: clamp(3rem, 5.5vw, 5.5rem); scroll-margin-top: 5.5rem; }
  .service-kicker { margin-bottom: .8rem; font-size: .68rem; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; color: var(--color-accent-dark); }
  .service-kicker.text-accent { color: var(--color-accent); }
  .service-heading { font-size: clamp(1.65rem, 3vw, 2.4rem); line-height: 1.15; font-weight: 600; max-width: 24ch; }
  .service-copy, .service-list { color: var(--color-steel-700); font-size: 1rem; line-height: 1.75; }
  .service-list { display: grid; gap: .8rem; }
  .service-list li { display: flex; gap: .65rem; }
  .service-jump a { min-height: 2.25rem; display: inline-flex; align-items: center; color: var(--color-steel-700); }
  .service-jump a:hover, .service-related:hover { color: var(--color-accent-dark); }
  .service-faq summary { list-style: none; }
  .service-faq summary::-webkit-details-marker { display: none; }
  .service-faq[open] :global(.faq-icon) { transform: rotate(45deg); }
  @media (max-width: 639px) { .service-copy, .service-list { font-size: .96rem; line-height: 1.7; } }
</style>
