---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business } from '../lib/business';

export const prerender = true;
---

<BaseLayout
  title="Thank You"
  description={`Thanks for contacting ${business.name}. We've got your request and will be in touch soon.`}
  robots="noindex, nofollow"
>
  <section class="bg-paper py-16 sm:py-24">
    <div class="mx-auto w-full max-w-lg px-5 text-center sm:px-8">
      <div class="mx-auto grid size-16 place-items-center rounded-full bg-accent-soft text-accent">
        <Icon name="circle-check-big" class="size-8" />
      </div>
      <h1 class="mt-6 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Request sent.
      </h1>
      <p class="mt-3 text-base leading-relaxed text-steel-700 sm:text-lg">
        Thanks - we&rsquo;ve got your details. We&rsquo;ll be in touch soon, usually within the hour during shop
        hours.
      </p>
      <p class="mt-2 text-sm text-steel-600">
        Prefer to talk now?{' '}
        <button
          type="button"
          data-open-chat
          class="font-semibold text-accent hover:text-accent-dark"
        >
          Chat with us
        </button>
      </p>

      <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="/"
          class="btn btn-primary w-full sm:w-auto"
        >
          Back to home
        </a>
        <a
          href="/services"
          class="btn btn-secondary w-full sm:w-auto"
        >
          Browse services
        </a>
      </div>

      <p class="mx-auto mt-10 max-w-md text-xs leading-relaxed text-steel-500">{business.laborGuide}</p>
    </div>
  </section>

  <!--
    Fire Meta Lead only when the visitor just submitted a quote form.
    Forms set sessionStorage before redirecting here so casual visits don't
    inflate conversion events. PageView still fires from BaseLayout.
  -->
  <script is:inline>
    (function () {
      try {
        if (sessionStorage.getItem('budgetauto-quote-submitted') === '1') {
          sessionStorage.removeItem('budgetauto-quote-submitted');
          if (typeof fbq === 'function') {
            fbq('track', 'Lead');
          }
        }
      } catch (e) {
        /* private mode / blocked storage - skip Lead, PageView still counted */
      }
    })();
  </script>
</BaseLayout>
