---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import ImageBand from '../components/ImageBand.astro';
import ContactActions from '../components/ContactActions.astro';
import { business } from '../lib/business';
import { landingServices } from '../lib/serviceDefinitions';
import { serviceMedia } from '../lib/serviceMedia';
import { breadcrumbJsonLd } from '../lib/seo';
import { serviceGroups, groupHref } from '../lib/serviceCatalog';
import heroServices from '../assets/images/hero-services.jpg';
import bgCta from '../assets/images/bg-cta-dark.jpg';

export const prerender = true;

const siteUrl = Astro.site?.origin ?? Astro.url.origin;
---

<BaseLayout
  title={`Auto Repair Services in ${business.address.city}, ${business.address.state}`}
  description={`Brakes, diagnostics, alignments, electrical, and more at ${business.name} in ${business.address.city}, ${business.address.state}. Browse services and book an appointment online.`}
  jsonLd={[
    breadcrumbJsonLd(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services/' },
    ]),
  ]}
  withServiceCatalog
>
  <PageHero
    image={heroServices}
    alt="Vehicles in an automotive workshop"
    eyebrow={`${business.address.city}, ${business.address.state}`}
    title={`Auto repair services in ${business.address.city}`}
    description={`Explore all 14 service categories at our shop on ${business.address.line1}. Get answers about symptoms, repair options, and what to expect before your visit.`}
    priority
  >
    <a
      slot="actions"
      href="/book/"
      data-contact-action="schedule"
      data-contact-location="services-hero"
      class="btn btn-primary"
    >
      <Icon name="calendar-check" class="size-4 shrink-0" />
      Schedule Appointment
    </a>
  </PageHero>

  <section class="bg-paper py-16 sm:py-20">
    <div class="container-shop">
      <div class="mb-9 max-w-2xl"><p class="mb-3 text-xs font-semibold tracking-[.15em] text-accent-dark uppercase">Find the right place to start</p><h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">Care for the whole vehicle.</h2><p class="mt-4 leading-relaxed text-steel-700">Choose a service for a full guide to the work. If the problem is hard to describe, send us a photo or tell us what changed.</p></div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {landingServices.map((service) => (
        <a
          href={`/services/${service.slug}/`}
          id={service.slug}
          class="group relative isolate flex min-h-64 scroll-mt-24 flex-col justify-end overflow-hidden rounded-card p-6 text-white shadow-lifted transition-transform hover:-translate-y-0.5 sm:min-h-72 sm:p-7"
        >
          <Image
            src={serviceMedia[service.slug].hero}
            alt={serviceMedia[service.slug].heroAlt}
            widths={[480, 768, 1024]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 -z-10 bg-linear-to-t from-ink/95 via-ink/55 to-ink/15"></div>
          <span class="mb-auto grid size-11 place-items-center rounded-full bg-white/15 text-white ring-1 ring-white/20 backdrop-blur-sm">
            <Icon name={service.icon} class="size-5" />
          </span>
          <div class="mt-6 flex items-end justify-between gap-3">
            <h2 class="font-display text-xl font-semibold text-white sm:text-2xl">{service.name}</h2>
            <Icon
              name="arrow-up-right"
              class="size-5 shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </div>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-steel-200">{service.description}</p>
        </a>
      ))}
      </div>
    </div>
  </section>

  {/*
    The complete service list, matching the Google Business Profile name for
    name. Every category above has a full service guide; this is the detailed
    service-label index for visitors who want a quick list.
  */}
  <section id="all-services" class="scroll-mt-24 border-t border-black/5 bg-surface py-16 sm:py-20">
    <div class="container-shop">
      <details><summary class="cursor-pointer py-3 font-display text-xl font-semibold">Browse individual services by category</summary>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {serviceGroups.map((group) => (
          <div id={`all-${group.key}`} data-reveal class="flex scroll-mt-24 flex-col rounded-card border border-black/5 bg-paper p-5 shadow-card">
            <a
              href={groupHref(group)}
              class="group flex items-center gap-3 font-display text-lg font-semibold text-ink hover:text-accent-dark"
            >
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft text-accent">
                <Icon name={group.icon} class="size-5" />
              </span>
              <span class="flex-1">{group.name}</span>
              <Icon
                name="arrow-up-right"
                class="size-4 shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </a>
            <ul class="mt-4 space-y-2 text-sm text-steel-700">
              {group.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <Icon name="circle-check-big" class="mt-0.5 size-4 shrink-0 text-accent" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      </details>
    </div>
  </section>

  <ImageBand image={bgCta} alt="Close-up of precision auto repair work under warm shop lights">
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
      Not sure what you need?
    </h2>
    <p class="mt-2 text-steel-300">
      Tell us what’s happening. We’ll help you take the next step.
    </p>
    <ContactActions tone="dark" location="services-cta" class="mt-6 max-w-lg" />
    <p class="mt-6 text-sm leading-relaxed text-steel-500">{business.laborGuide}</p>
  </ImageBand>
</BaseLayout>
