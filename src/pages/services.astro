---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business, services } from '../lib/business';
import bayImage from '../assets/images/services-bay.png';
import engineImage from '../assets/images/detail-engine.png';
import brakesImage from '../assets/images/detail-brakes.png';
import diagnosticsImage from '../assets/images/detail-diagnostics.png';
import suspensionImage from '../assets/images/detail-suspension.png';
import electricalImage from '../assets/images/detail-electrical.png';

const serviceImages: Record<string, ImageMetadata> = {
  diagnostics: diagnosticsImage,
  'engine-maintenance': engineImage,
  'brake-services': brakesImage,
  'suspension-alignment': suspensionImage,
  'electrical-systems': electricalImage,
  'general-repairs': bayImage,
};

export const prerender = true;
---

<BaseLayout
  title="Services"
  description={`Repair and maintenance services at ${business.name} in ${business.address.city}, ${business.address.state}. Request a free quote for your vehicle.`}
>
  <section class="bg-paper py-16 sm:py-20">
    <div class="container-shop grid gap-4 sm:grid-cols-2">
      {services.map((service) => (
        <a
          href={`/quote/${service.slug}`}
          id={service.slug}
          class="group relative isolate flex min-h-64 scroll-mt-24 flex-col justify-end overflow-hidden rounded-card p-6 text-white shadow-lifted transition-transform hover:-translate-y-0.5 sm:min-h-72 sm:p-7"
        >
          <Image
            src={serviceImages[service.slug]}
            alt={service.name}
            widths={[480, 768, 1024]}
            sizes="(min-width: 640px) 50vw, 100vw"
            class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 -z-10 bg-linear-to-t from-ink/95 via-ink/55 to-ink/15"></div>
          <span class="mb-auto grid size-11 place-items-center rounded-full bg-white/15 text-white ring-1 ring-white/20 backdrop-blur-sm">
            <Icon name={service.icon} class="size-5" />
          </span>
          <div class="mt-6 flex items-end justify-between gap-3">
            <h2 class="font-display text-xl font-semibold text-white sm:text-2xl">{service.name}</h2>
            <Icon
              name="arrow-up-right"
              class="size-5 shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </div>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-steel-200">{service.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-black/5 bg-ink py-16 text-white sm:py-20">
    <div class="container-shop max-w-2xl">
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
        Don't see what's wrong with your car listed?
      </h2>
      <p class="mt-2 text-steel-300">
        Send a photo from the Free Quote button in the header — we'll figure out what it is and get back to you.
      </p>
      <p class="mt-6 text-sm leading-relaxed text-steel-500">{business.laborGuide}</p>
    </div>
  </section>
</BaseLayout>
