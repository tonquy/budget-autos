---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceQuoteForm from '../../components/quote/ServiceQuoteForm';
import { business, services } from '../../lib/business';
import { breadcrumbJsonLd } from '../../lib/seo';
import heroQuote from '../../assets/images/hero-quote.jpg';

// One statically-generated page per advertised service. Visitors land here when
// they click a specific service (e.g. Brake Services), so we show a slim form
// with the service already prefilled instead of the general request form.
export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

export const prerender = true;

const { service } = Astro.props;
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
---

<BaseLayout
  title={`${service.name} Quote`}
  description={`Request a free ${service.name.toLowerCase()} quote from ${business.name} in ${business.address.city}, ${business.address.state}. Just your name, vehicle, and what's wrong.`}
  jsonLd={[
    breadcrumbJsonLd(siteUrl, [
      { name: 'Home', path: '/' },
      { name: service.name, path: `/services/${service.slug}` },
      { name: 'Quote', path: `/quote/${service.slug}` },
    ]),
  ]}
>
  <PageHero
    image={heroQuote}
    alt={`Photographing a vehicle issue for a ${service.name.toLowerCase()} quote`}
    eyebrow={service.name}
    title={`Get a quote for your ${service.name.toLowerCase()}.`}
    description={`Tell us your name, your vehicle, and what's going on - we'll get back to you with a real price. No account, no obligation.`}
    size="compact"
    objectPosition="center 40%"
    priority
  >
    <a
      slot="actions"
      href={`/services/${service.slug}`}
      class="btn btn-on-dark"
    >
      See {service.name.toLowerCase()} details
    </a>
  </PageHero>

  <section class="bg-paper py-8 sm:py-12 lg:py-16">
    <div
      id="intake-wizard"
      class="mx-auto w-full max-w-xl scroll-mt-24 px-5 sm:max-w-xl sm:px-8 lg:max-w-2xl"
    >
      <div class="rounded-card border border-black/5 bg-surface p-5 shadow-card sm:p-8 lg:p-10">
        <ServiceQuoteForm serviceName={service.name} client:load />
      </div>

      <p class="mt-5 text-center text-sm text-steel-600">
        Not sure what&rsquo;s wrong?{' '}
        <a href="/quote" class="font-semibold text-accent hover:text-accent-dark">
          Use the general service request
        </a>
        , or text us at{' '}
        <a
          href={`sms:${business.smsNumber}`}
          data-sms-link
          data-sms-number={business.smsNumber}
          data-sms-body={business.smsBody}
          data-contact-action="text"
          data-contact-location="service-quote-page"
          class="font-semibold text-accent hover:text-accent-dark"
        >
          {business.phoneDisplay}
        </a>
        .
      </p>
    </div>
  </section>
</BaseLayout>
