---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceRequestForm from '../components/quote/ServiceRequestForm';
import { business } from '../lib/business';

export const prerender = true;
---

{/*
  No photo hero on this page. The page has exactly one job - collect the
  request - and a 16rem hero image pushed the form below the fold on a phone.
*/}
<BaseLayout
  title="Get a Free Quote"
  description={`Get a free repair quote from ${business.name} in ${business.address.city}. Name, phone, email, and a photo if you have one. No account.`}
>
  <section class="flex min-h-[calc(100dvh-4.25rem)] flex-col bg-paper py-6 sm:py-12 lg:py-16">
    <div
      id="intake-wizard"
      class="mx-auto flex w-full max-w-xl flex-1 flex-col px-5 scroll-mt-24 sm:px-8 lg:max-w-2xl"
    >
      <div
        class="flex flex-1 flex-col rounded-card border border-black/5 bg-surface p-5 shadow-card sm:p-8 lg:p-10"
      >
        <ServiceRequestForm client:load />
      </div>

      <p class="mt-4 text-center text-sm text-steel-600">
        Rather not type it out?{' '}
        <a
          href={`sms:${business.smsNumber}`}
          data-sms-link
          data-sms-number={business.smsNumber}
          data-sms-body={business.smsBody}
          data-contact-action="text"
          data-contact-location="quote-page"
          class="font-semibold text-accent hover:text-accent-dark"
        >
          Text us
        </a>
        {' or '}
        <a
          href={business.phoneHref}
          data-contact-action="call"
          data-contact-location="quote-page"
          class="font-semibold text-accent hover:text-accent-dark"
        >
          call {business.phoneDisplay}
        </a>
        .
      </p>
    </div>
  </section>
</BaseLayout>
