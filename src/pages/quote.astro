---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/quote/QuoteForm';
import { business } from '../lib/business';

export const prerender = true;
---

<BaseLayout
  title="Get a Free Quote"
  description={`Request a free repair quote from ${business.name}. Upload a photo of the issue and we'll text or call back with a real price.`}
>
  <section class="bg-paper py-14 sm:py-20">
    <div class="container-shop grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-12">
      <div>
        <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          Get a free quote.
        </h1>
        <p class="mt-3 text-steel-700">
          Tell us what&rsquo;s going on and add a photo or two if you can. We&rsquo;ll get back to you with a real price - most days within the hour.
        </p>

        <div class="mt-8 space-y-5 rounded-card border border-black/5 bg-surface p-6 shadow-card">
          <div class="flex items-start gap-3">
            <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-accent" />
            <div>
              <p class="text-sm font-semibold text-ink">Fast replies</p>
              <p class="text-sm text-steel-700">Usually within the hour during shop hours.</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="shield-check" class="mt-0.5 size-5 shrink-0 text-accent" />
            <div>
              <p class="text-sm font-semibold text-ink">No pressure</p>
              <p class="text-sm text-steel-700">Free to ask. No work starts until you approve it.</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="phone" class="mt-0.5 size-5 shrink-0 text-accent" />
            <div>
              <p class="text-sm font-semibold text-ink">Prefer to talk?</p>
              <a href={business.phoneHref} class="text-sm font-semibold text-accent hover:text-accent-dark">
                {business.phoneDisplay}
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-card border border-black/5 bg-surface p-6 shadow-card sm:p-8">
        <QuoteForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>
