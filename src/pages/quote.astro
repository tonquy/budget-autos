---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntakeWizard from '../components/quote/IntakeWizard';
import { business } from '../lib/business';

export const prerender = true;
---

<BaseLayout
  title="Get a Free Quote"
  description={`Request a free repair quote from ${business.name}. Upload a photo of the issue and we'll get back to you with a real price.`}
>
  <section class="bg-paper py-5 sm:py-12 lg:py-16">
    <div class="mx-auto w-full max-w-xl px-5 sm:max-w-xl sm:px-8 lg:max-w-2xl">
      <div
        id="intake-wizard"
        class="rounded-card border border-black/5 bg-surface p-5 shadow-card sm:p-8 lg:p-10"
      >
        <IntakeWizard client:load />
      </div>
    </div>
  </section>
</BaseLayout>
