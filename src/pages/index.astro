---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import RecentJobs from '../components/home/RecentJobs.astro';
import DropOffBand from '../components/home/DropOffBand.astro';
import ServicesPreview from '../components/home/ServicesPreview.astro';
import LocationBlock from '../components/home/LocationBlock.astro';
import { business } from '../lib/business';

export const prerender = true;
---

<BaseLayout
  title={`Auto Repair in ${business.address.city}, ${business.address.state}`}
  description={`Family-owned auto repair on ${business.address.line1} in ${business.address.city} since ${business.foundedYear}. Repair-estimate second opinions, check-engine diagnostics, brakes, and alignment help.`}
  withServiceCatalog
>
  <Hero />
  <TrustBar />
  <ServicesPreview />
  <DropOffBand />
  <RecentJobs />
  <LocationBlock />
</BaseLayout>
