---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../lib/business';

export const prerender = true;
const lastUpdated = 'January 2026';
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${business.name} collects, uses, and protects the information you share with us.`}
>
  <section class="bg-paper py-16 sm:py-20">
    <div class="container-shop max-w-2xl">
      <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Privacy Policy</h1>
      <p class="mt-2 text-sm text-steel-500">Last updated {lastUpdated}</p>

      <div class="mt-8 space-y-8 text-steel-700">
        <p class="text-sm leading-relaxed text-steel-500">
          This is placeholder policy text for the {business.name} website mockup. Replace it with
          language reviewed by a qualified attorney before the site goes live.
        </p>

        <div>
          <h2 class="font-display text-lg font-semibold text-ink">Information we collect</h2>
          <p class="mt-2 leading-relaxed">
            When you submit a quote request, we collect the information you provide directly: your
            name, phone number, email address (if given), vehicle details, a description of the
            issue, and any photos you choose to upload. We do not require an account and we do not
            collect payment information through this website.
          </p>
        </div>

        <div>
          <h2 class="font-display text-lg font-semibold text-ink">How we use it</h2>
          <p class="mt-2 leading-relaxed">
            We use the information you submit solely to respond to your quote request - by phone,
            text, or email, depending on what you choose - and to prepare an estimate for the work
            you're asking about. We do not sell your information to third parties.
          </p>
        </div>

        <div>
          <h2 class="font-display text-lg font-semibold text-ink">Photos you upload</h2>
          <p class="mt-2 leading-relaxed">
            Photos submitted with a quote request are stored securely and used only to evaluate your
            repair request. We may keep them on file as part of your service record.
          </p>
        </div>

        <div>
          <h2 class="font-display text-lg font-semibold text-ink">Data retention & security</h2>
          <p class="mt-2 leading-relaxed">
            We keep quote request information for as long as reasonably necessary to respond to you
            and maintain service records, and we use industry-standard measures to protect it in
            transit and storage.
          </p>
        </div>

        <div>
          <h2 class="font-display text-lg font-semibold text-ink">Contact us</h2>
          <p class="mt-2 leading-relaxed">
            Questions about this policy or your information? Reach us at{' '}
            <a href={`mailto:${business.email}`} class="text-accent hover:text-accent-dark">{business.email}</a>{' '}
            or <a href={business.phoneHref} class="text-accent hover:text-accent-dark">{business.phoneDisplay}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
