---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import TrustBar from '../../components/home/TrustBar.astro';
import LocationIntro from '../../components/locations/LocationIntro.astro';
import ServicesPreview from '../../components/home/ServicesPreview.astro';
import QuoteCallout from '../../components/home/QuoteCallout.astro';
import ReviewsCta from '../../components/home/ReviewsCta.astro';
import LocationBlock from '../../components/home/LocationBlock.astro';
import HomeFaq from '../../components/home/HomeFaq.astro';
import { business } from '../../lib/business';
import { isIndexableLocation, locations, type Location } from '../../lib/locations';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { city: location.slug },
    props: { location },
  }));
}

export const prerender = true;

interface Props {
  location: Location;
}

const { location } = Astro.props;
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const regionLabel = location.state === 'PA' ? 'PA' : 'NY';
---

{/*
  City landings share the homepage sections but lead with a block that is
  actually about the town (LocationIntro) and close with that town's own FAQ,
  so no two city pages read as copies of each other or of the homepage.
*/}
<BaseLayout
  title={location.seoTitle ?? `Auto Repair in ${location.name}, ${regionLabel}`}
  description={location.seoDescription}
  robots={isIndexableLocation(location) ? undefined : 'noindex, follow'}
  jsonLd={[
    breadcrumbJsonLd(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Service Areas', path: '/locations/' },
      { name: location.name, path: `/locations/${location.slug}/` },
    ]),
    faqJsonLd(location.faqs),
  ]}
>
  <Hero
    titleLine1={`Auto repair in ${location.name}`}
    titleLine2="No surprises on the bill."
    description={`Family-owned shop on ${business.address.line1} in ${business.address.city} - serving ${location.name} drivers since ${business.foundedYear}. ${location.driveNote}`}
    eyebrow={business.name}
    imageAlt={`Auto repair for ${location.name} drivers from ${business.name} in ${business.address.city}`}
  />
  <TrustBar />
  <LocationIntro location={location} />
  <ServicesPreview />
  <QuoteCallout />
  <ReviewsCta />
  <LocationBlock />
  <HomeFaq
    faqs={location.faqs}
    title={`Questions from ${location.name} drivers.`}
    intro={`How to reach us from ${location.name}, how quotes work, and what we fix.`}
  />
</BaseLayout>
