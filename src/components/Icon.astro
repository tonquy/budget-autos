interface Props {
  name: keyof typeof icons;
  class?: string;
  id?: string;
}

const { name, class: className = '', id } = Astro.props;
const body = icons[name] ?? '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  class={className}
  id={id}
  aria-hidden="true"
  set:html={body}
/>
