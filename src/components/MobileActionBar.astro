---
import Icon from './Icon.astro';
import { business } from '../lib/business';

// On the quote page the form itself is the primary action, so we only surface
// a call button there instead of a redundant "Get a quote" CTA.
const isQuotePage = Astro.url.pathname.replace(/\/$/, '') === '/quote';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-black/10 bg-paper/95 px-4 pt-2.5 backdrop-blur-md md:hidden"
  style="padding-bottom: calc(0.625rem + env(safe-area-inset-bottom));"
>
  <div class="flex gap-2.5">
    <a
      href={business.phoneHref}
      class:list={[
        'inline-flex items-center justify-center gap-2 rounded-control py-3 text-sm font-semibold transition-colors',
        isQuotePage
          ? 'flex-1 bg-accent text-white'
          : 'flex-1 border border-ink/15 bg-surface text-ink',
      ]}
    >
      <Icon name="phone" class="size-4" />
      Call {business.phoneDisplay}
    </a>
    {!isQuotePage && (
      <a
        href="/quote"
        class="inline-flex flex-1 items-center justify-center gap-2 rounded-control bg-accent py-3 text-sm font-semibold text-white"
      >
        <Icon name="camera" class="size-4" />
        Get a quote
      </a>
    )}
  </div>
</div>
