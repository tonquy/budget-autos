---
import Icon from './Icon.astro';

// On any quote page (the wizard at /quote or a per-service form at /quote/*) the
// form itself is the primary action, so the bar is hidden entirely there -
// otherwise the fixed CTA overlaps the form's submit button on mobile.
// Everywhere else it surfaces a single thumb-reachable CTA.
const path = Astro.url.pathname.replace(/\/$/, '');
const isQuotePage = path === '/quote' || path.startsWith('/quote/');
---

{
  !isQuotePage && (
    <>
      {/* Spacer so the fixed bar never covers the footer's last row. */}
      <div class="h-20 md:hidden" aria-hidden="true" />
      <div
        class="fixed inset-x-0 bottom-0 z-40 border-t border-black/10 bg-paper/95 px-4 pt-2.5 backdrop-blur-md md:hidden"
        style="padding-bottom: calc(0.625rem + env(safe-area-inset-bottom));"
      >
        <a
          href="/quote"
          class="inline-flex min-h-12 w-full touch-manipulation items-center justify-center gap-2 rounded-control bg-accent py-3 text-sm font-semibold text-white"
        >
          <Icon name="camera" class="size-4" />
          Get a Free Quote
        </a>
      </div>
    </>
  )
}
