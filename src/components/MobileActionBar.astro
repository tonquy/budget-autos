---
import Icon from './Icon.astro';
import { business } from '../lib/business';

// Thumb-reachable version of the shop's three contact choices. On any quote page
// the form itself is the primary action, so the bar is hidden entirely there -
// otherwise the fixed CTA overlaps the form's submit button on mobile.
const path = Astro.url.pathname.replace(/\/$/, '');
const isQuotePage = path === '/quote' || path.startsWith('/quote/');
const hideActionBar = isQuotePage || path === '/rental' || path === '/thank-you';

const item =
  'inline-flex min-h-12 flex-1 touch-manipulation flex-col items-center justify-center gap-0.5 rounded-control py-1.5 text-[11px] font-semibold leading-tight';
---

{
  !hideActionBar && (
    <>
      {/* Spacer so the fixed bar never covers the footer's last row. */}
      <div class="h-20 md:hidden" aria-hidden="true" />
      <div
        id="mobile-action-bar"
        class="mobile-bar fixed inset-x-0 bottom-0 z-40 border-t border-black/10 bg-paper/95 px-3 pt-2 backdrop-blur-md md:hidden"
        style="padding-bottom: calc(0.5rem + env(safe-area-inset-bottom));"
      >
        <div class="flex items-stretch gap-2">
          <a
            href={`sms:${business.smsNumber}`}
            data-sms-link
            data-sms-number={business.smsNumber}
            data-sms-body={business.smsBody}
            data-contact-action="text"
            data-contact-location="mobile-bar"
            class={`${item} bg-accent text-white`}
          >
            <Icon name="message-square" class="size-4" />
            Text Us
          </a>
          <a
            href={business.phoneHref}
            data-contact-action="call"
            data-contact-location="mobile-bar"
            class={`${item} border border-ink/15 text-ink`}
          >
            <Icon name="phone" class="size-4" />
            Call Us
          </a>
          <a
            href="/quote"
            data-contact-action="request"
            data-contact-location="mobile-bar"
            class={`${item} border border-ink/15 text-ink`}
          >
            <Icon name="clipboard-list" class="size-4" />
            Request
          </a>
        </div>
      </div>
    </>
  )
}

{/*
  is:inline and placed directly after the bar so it runs synchronously at this
  point in the parse - a deferred module would let the bar paint once before
  being hidden, which reads as a flicker on every page load.
*/}
<script is:inline>
  (function () {
    var bar = document.getElementById('mobile-action-bar');
    if (!bar) return;

    // Only heroes that carry their own contact buttons should suppress the bar.
    var hero = document.querySelector('[data-hero-actions]');
    if (!hero) return;

    function sync(visible) {
      bar.classList.toggle('is-tucked', visible);
    }

    // Set the correct state before the first paint. Covers reloads where the
    // browser restores a scroll position partway down the page.
    sync(hero.getBoundingClientRect().bottom > 0);

    if (!('IntersectionObserver' in window)) return;

    new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          sync(entry.isIntersecting);
        });
      },
      { threshold: 0 },
    ).observe(hero);
  })();
</script>
