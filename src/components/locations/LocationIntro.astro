---
import Icon from '../Icon.astro';
import { getLocationBySlug, type Location } from '../../lib/locations';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const nearby = location.nearbySlugs
  .map((slug) => getLocationBySlug(slug))
  .filter((place): place is Location => Boolean(place));
---

{/*
  The one section that is genuinely about this town. Everything else on a city
  page is shared with the homepage, so without this block the 36 city pages were
  99% identical to each other - which reads as doorway pages to Google. The copy
  comes from src/lib/locations.ts (intro, drive time, landmarks, highlights).
*/}
<section class="bg-paper py-16 sm:py-20">
  <div data-reveal class="container-shop grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-14">
    <div>
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Auto repair for {location.name} drivers.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-steel-700">{location.intro}</p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {location.highlights.map((highlight) => (
          <li class="flex items-start gap-3 rounded-card border border-black/5 bg-surface px-4 py-3">
            <Icon name="badge-check" class="mt-0.5 size-5 shrink-0 text-accent" />
            <span class="text-steel-700">{highlight}</span>
          </li>
        ))}
      </ul>
    </div>

    <aside class="rounded-card border border-black/5 bg-surface p-6 shadow-card">
      <h3 class="font-display text-xl font-semibold text-ink">Getting here from {location.name}</h3>
      <p class="mt-3 leading-relaxed text-steel-700">{location.driveNote}</p>
      <p class="mt-3 text-sm text-steel-600">
        <span class="font-medium text-ink">Landmarks:</span> {location.landmarks}
      </p>
      <p class="mt-2 text-sm text-steel-600">{location.county}, {location.state}</p>

      {nearby.length > 0 && (
        <div class="mt-6 border-t border-black/5 pt-5">
          <h4 class="text-sm font-semibold uppercase tracking-wide text-steel-600">Also serving nearby</h4>
          <ul class="mt-3 flex flex-wrap gap-2">
            {nearby.map((place) => (
              <li>
                <a
                  href={`/locations/${place.slug}/`}
                  class="inline-flex rounded-full border border-black/10 px-3 py-1 text-sm text-steel-700 transition-colors hover:border-accent hover:text-accent"
                >
                  {place.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</section>
