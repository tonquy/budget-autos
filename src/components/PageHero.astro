---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  description?: string;
  /** compact | default | tall */
  size?: 'compact' | 'default' | 'tall';
  objectPosition?: string;
  priority?: boolean;
}

const {
  image,
  alt,
  eyebrow,
  title,
  description,
  size = 'default',
  objectPosition = 'center 40%',
  priority = false,
} = Astro.props;

const hasActions = Astro.slots.has('actions');
const hasBreadcrumb = Astro.slots.has('breadcrumb');

const heightClass =
  size === 'compact'
    ? 'min-h-[16rem] sm:min-h-[18rem] lg:min-h-[20rem]'
    : size === 'tall'
      ? 'min-h-[min(72dvh,28rem)] sm:min-h-[min(68dvh,34rem)] lg:min-h-[min(70dvh,38rem)]'
      : 'min-h-[min(52dvh,22rem)] sm:min-h-[min(48dvh,26rem)] lg:min-h-[min(50dvh,28rem)]';
---

<section class:list={['page-hero relative overflow-hidden bg-ink text-white', heightClass]}>
  <div class="absolute inset-0">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      class="page-hero-image size-full object-cover"
      style={`object-position: ${objectPosition}`}
    />
    <div
      class="absolute inset-0 bg-linear-to-t from-ink/95 via-ink/60 to-ink/30 sm:bg-linear-to-r sm:from-ink/90 sm:via-ink/50 sm:to-ink/25"
      aria-hidden="true"
    ></div>
  </div>

  <div class="relative container-shop flex h-full flex-col justify-end py-10 sm:justify-center sm:py-14 lg:py-16">
    {hasBreadcrumb && <slot name="breadcrumb" />}
    <div class="page-hero-copy max-w-2xl">
      {eyebrow && (
        <p class="font-display text-xs font-semibold tracking-[0.18em] text-accent uppercase sm:text-sm">
          {eyebrow}
        </p>
      )}
      <h1 class="mt-2.5 font-display text-[2rem] font-bold leading-[1.08] tracking-tight text-balance text-white sm:text-4xl lg:text-5xl">
        {title}
      </h1>
      {description && (
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-steel-200 sm:mt-5 sm:text-base">
          {description}
        </p>
      )}
      {hasActions && (
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <slot name="actions" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero-image {
    animation: page-hero-ken 18s ease-out forwards;
  }

  .page-hero-copy {
    animation: page-hero-rise 0.85s cubic-bezier(0.32, 0.72, 0, 1) both;
  }

  @keyframes page-hero-ken {
    from {
      transform: scale(1.05);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes page-hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero-image,
    .page-hero-copy {
      animation: none;
    }
  }
</style>
