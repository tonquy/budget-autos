---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  objectPosition?: string;
}

const { image, alt, objectPosition = 'center 50%' } = Astro.props;
---

<section class="relative overflow-hidden bg-ink py-16 text-white sm:py-20">
  <div class="absolute inset-0">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      class="size-full object-cover"
      style={`object-position: ${objectPosition}`}
    />
    <div class="absolute inset-0 bg-ink/80" aria-hidden="true"></div>
  </div>
  <div class="relative container-shop max-w-2xl">
    <slot />
  </div>
</section>
