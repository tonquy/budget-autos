---
import Icon from '../Icon.astro';
---
<section id="rental" class="border-y border-black/5 bg-accent-soft py-12 sm:py-16" aria-labelledby="rental-title">
  <div class="container-shop flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:gap-10 sm:text-left">
    <div class="max-w-xl">
      <h2 id="rental-title" class="font-display text-2xl font-bold text-ink sm:text-3xl">A rental while we repair your car.</h2>
      <p class="mt-3 text-ink-soft">$35/day, with up to 100 miles included per day. Available for repair customers.</p>
    </div>
    <a href="/rental/" data-contact-action="request-rental" data-contact-location="dropoff-band" class="btn btn-ink shrink-0">
      <Icon name="key-round" class="size-4" />Request a rental
    </a>
  </div>
</section>
