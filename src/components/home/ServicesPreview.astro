---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { services } from '../../lib/business';
import { serviceImages } from '../../lib/serviceImages';

// Every service is a photo tile - real shop photography exists for all seven,
// so none of them fall back to a plain text row.
//
// Cell count matches the content exactly, with no empty tiles: the first
// service spans the full width as a lead tile, and the remaining six fill three
// even rows of two. Mobile collapses to a single column.
---

<section class="bg-paper py-20 sm:py-28">
  <div class="container-shop">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div class="max-w-lg">
        <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
          Most of what breaks, we fix the same day.
        </h2>
        <p class="mt-3 text-steel-700">
          From routine maintenance to the stuff that leaves you stranded, here's what we handle most.
        </p>
      </div>
      <a
        href="/services"
        class="group inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent-dark"
      >
        View all services
        <Icon
          name="arrow-up-right"
          class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-5" data-reveal="stagger">
      {
        services.map((service, i) => (
          <a
            href={`/services/${service.slug}`}
            class:list={[
              'group relative overflow-hidden rounded-card bg-ink shadow-card transition-shadow duration-500 hover:shadow-lifted',
              i === 0 && 'sm:col-span-2',
            ]}
          >
            <Image
              src={serviceImages[service.slug]}
              alt={`${service.name} at Budget Auto Repair`}
              widths={[480, 768, 1024, 1440]}
              sizes={i === 0 ? '(min-width: 640px) 90vw, 92vw' : '(min-width: 640px) 45vw, 92vw'}
              loading="lazy"
              class:list={[
                'w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-[1.04]',
                i === 0 ? 'aspect-16/10 sm:aspect-21/9' : 'aspect-16/10',
              ]}
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-ink via-ink/55 to-transparent"
              aria-hidden="true"
            />
            <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
              <div class="flex items-center gap-2.5">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent text-white">
                  <Icon name={service.icon} class="size-4.5" />
                </span>
                <h3 class="font-display text-lg font-semibold text-white sm:text-xl">
                  {service.name}
                </h3>
              </div>
              <p class="mt-2 line-clamp-2 max-w-sm text-sm leading-relaxed text-steel-200">
                {service.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
