---
import Icon from '../Icon.astro';
import { services } from '../../lib/business';

const preview = services;
---

<section class="bg-paper py-20 sm:py-28">
  <div class="container-shop">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-lg">
        <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          Most of what breaks, we fix the same day.
        </h2>
        <p class="mt-3 text-steel-700">
          From routine maintenance to the stuff that leaves you stranded - here's what we handle most.
        </p>
      </div>
      <a
        href="/services"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent-dark"
      >
        View all services
        <Icon name="arrow-up-right" class="size-4" />
      </a>
    </div>

    <div class="mt-10 divide-y divide-black/5">
      {preview.map((service) => (
        <a
          href={`/quote/${service.slug}`}
          class="group flex flex-col gap-4 py-6 transition-colors sm:flex-row sm:items-start sm:gap-6"
        >
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-accent-soft text-accent transition-colors group-hover:bg-accent group-hover:text-white">
            <Icon name={service.icon} class="size-6" />
          </span>
          <span class="flex-1">
            <span class="font-display text-lg font-semibold text-ink transition-colors group-hover:text-accent-dark">
              {service.name}
            </span>
            <span class="mt-1.5 block leading-relaxed text-steel-700">{service.description}</span>
          </span>
          <Icon
            name="chevron-right"
            class="hidden size-5 shrink-0 self-center text-steel-500 transition-transform group-hover:translate-x-1 group-hover:text-accent sm:block"
          />
        </a>
      ))}
    </div>
  </div>
</section>
