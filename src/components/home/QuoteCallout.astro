---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { business } from '../../lib/business';
import quoteImage from '../../assets/images/quote-photo-upload.jpg';

// Text is the mechanism here rather than an upload form: it needs no account and
// no app, every phone already has it, and it puts the shop in a thread with the
// customer instead of an inbox. The section used to describe a form and carried
// no button of its own, which left the three steps with nowhere to go.
const steps = [
  {
    title: 'Snap a photo',
    description: "A cracked hose, a dashboard light, an estimate from another shop - whatever you've got.",
  },
  {
    title: 'Text it to us',
    description: 'A couple sentences is plenty. No account, no app to download.',
  },
  {
    title: 'We call or text you back',
    description: 'Usually within the hour during shop hours, with a real number - not a range.',
  },
];
---

<section class="bg-ink py-20 text-white sm:py-28">
  <div
    data-reveal
    class="container-shop grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-10"
  >
    <div class="relative order-2 lg:order-1">
      <div class="overflow-hidden rounded-card shadow-lifted">
        <Image
          src={quoteImage}
          alt="Close-up of a customer photographing a car part on their phone to send for a repair quote"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 40vw, 90vw"
          class="aspect-4/3 w-full object-cover"
        />
      </div>
    </div>

    <div class="order-1 max-w-xl lg:order-2">
      <span class="inline-flex items-center gap-1.5 rounded-control bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent">
        <Icon name="image-plus" class="size-3.5" />
        Skip the guesswork
      </span>
      <h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Not sure what it's called? Just show us.
      </h2>
      <p class="mt-3 text-steel-300">
        Half the battle with car trouble is explaining it over the phone. Text us a photo straight from your phone instead, so we're looking at the same thing you are.
      </p>

      <ol class="mt-8 space-y-6">
        {steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-accent/50 font-display text-sm font-semibold text-accent">
              {i + 1}
            </span>
            <div>
              <p class="font-display font-semibold text-white">{step.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-steel-300">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <a
        href={`sms:${business.smsNumber}`}
        data-sms-link
        data-sms-number={business.smsNumber}
        data-sms-body={business.smsBody}
        data-contact-action="text"
        data-contact-location="quote-callout"
        class="btn btn-primary mt-8 w-full sm:w-auto"
      >
        <Icon name="message-square" class="size-4 shrink-0" />
        Text us a photo
      </a>
    </div>
  </div>
</section>
