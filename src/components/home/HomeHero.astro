---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import HeroQuoteForm from './HeroQuoteForm.astro';
import heroImage from '../../assets/images/hero-home.jpg';
import { business } from '../../lib/business';
---

{/*
  Full-height homepage hero over the shop photo. The same image serves mobile
  and desktop; object-fit keeps the bay centred at every width.

  Desktop: headline on the left, quick quote form on the right.
  Mobile: headline, then the form, then the call / schedule alternatives.
  data-hero-actions sits on the whole content block so the fixed mobile action
  bar stays tucked away while the form is on screen.
*/}
<section class="hero home-hero" aria-labelledby="home-heading">
  <div class="hero-media" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      quality={65}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-content container-shop" data-hero-actions>
    <div class="hero-copy">
      <p class="hero-eyebrow">Family-owned. Since {business.foundedYear}.</p>
      <h1 id="home-heading">Best auto repair in<br />Johnson City, NY.</h1>
      <p class="hero-description">From check-engine lights to brakes and everyday maintenance, we help you understand what your car needs—and what it will cost before the work begins.</p>
    </div>
    <div class="hero-form-slot">
      <HeroQuoteForm />
    </div>
    <div class="hero-alt">
      <p class="hero-alt-label">Rather talk or pick a time?</p>
      <div class="hero-actions">
        <a href={business.phoneHref} class="btn btn-on-dark btn-lg" data-contact-action="call" data-contact-location="home-hero">Call {business.phoneDisplay}</a>
        <a href="/book/" class="btn btn-on-dark btn-lg" data-contact-action="schedule" data-contact-location="home-hero">Schedule Appointment <Icon name="calendar-check" class="size-4" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero { position: relative; isolation: isolate; display: grid; place-items: center; min-height: max(42rem, 100dvh); overflow: hidden; background: #17181c; color: white; }
  .hero-media, .hero-veil { position: absolute; inset: 0; z-index: -1; }
  .hero-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .hero-veil { background: linear-gradient(180deg, rgb(12 18 22 / 60%), rgb(12 18 22 / 66%) 50%, rgb(12 18 22 / 80%)); }
  .hero-content { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 25.5rem); grid-template-areas: 'copy form' 'alt form'; column-gap: clamp(2rem, 6vw, 5rem); align-items: center; padding-block: 7.5rem 4.5rem; }
  .hero-copy { grid-area: copy; align-self: end; }
  .hero-form-slot { grid-area: form; }
  .hero-alt { grid-area: alt; align-self: start; margin-top: 2rem; }
  .hero-eyebrow { margin-bottom: 1.25rem; font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #eee5db; }
  h1 { font-size: clamp(2.5rem, 4.4vw, 3.75rem); font-weight: 700; line-height: 1.05; letter-spacing: -.045em; }
  .hero-description { max-width: 33rem; margin-top: 1.5rem; font-size: 1.0625rem; line-height: 1.65; color: #e8e5e1; }
  .hero-alt-label { margin-bottom: .75rem; font-size: .8125rem; font-weight: 500; color: #e8e5e1; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .625rem; }
  .hero-actions .btn { min-height: 3rem; padding-inline: 1.25rem; font-size: .875rem; }
  @media (max-width: 1023px) {
    .hero-content { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'copy' 'form' 'alt'; justify-items: center; row-gap: 1.75rem; text-align: center; }
    .hero-copy { display: flex; flex-direction: column; align-items: center; }
    .hero-form-slot { width: min(100%, 27rem); }
    .hero-alt { margin-top: 0; }
    .hero-actions { justify-content: center; }
  }
  @media (max-width: 767px) {
    .home-hero { min-height: max(40rem, 100dvh); }
    .hero-content { row-gap: 1.75rem; padding-block: 5.5rem 2.5rem; }
    .hero-eyebrow { margin-bottom: .75rem; }
    h1 { font-size: clamp(2rem, 8.5vw, 2.75rem); }
    /* The form card carries the pitch on a phone; this keeps the button above the fold. */
    .hero-description { display: none; }
    .hero-actions { flex-direction: column; width: min(100%, 17rem); margin-inline: auto; }
  }
</style>
