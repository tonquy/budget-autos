---
import Icon from '../Icon.astro';
import { business, yearsInBusiness } from '../../lib/business';

const stats = [
  { icon: 'calendar-days', label: `${yearsInBusiness}+ years serving the area` },
  { icon: 'shield-check', label: business.warranty },
  { icon: 'badge-check', label: 'Licensed & insured technicians' },
  { icon: 'thumbs-up', label: 'Free quotes, no pressure' },
];
---

{/*
  Sits directly under the hero. Pulled up with a negative margin so it overlaps
  the hero edge, which gives the top of the page a sense of layering instead of
  four stacked full-width bands butting against each other.
*/}
<section class="relative z-10 -mt-8 sm:-mt-10">
  <div class="container-shop">
    <div
      class="grid grid-cols-2 gap-x-5 gap-y-5 rounded-card border border-black/5 bg-surface p-5 shadow-lifted sm:grid-cols-4 sm:gap-4 sm:p-6"
      data-reveal="stagger"
    >
      {stats.map((stat) => (
        <div class="flex items-start gap-3">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent-soft text-accent">
            <Icon name={stat.icon} class="size-4.5" />
          </span>
          <span class="text-sm font-medium leading-snug text-ink-soft">{stat.label}</span>
        </div>
      ))}
    </div>

    <p class="mt-4 text-center text-xs leading-relaxed text-steel-500 sm:text-sm">
      {business.laborGuide}
    </p>
  </div>
</section>
