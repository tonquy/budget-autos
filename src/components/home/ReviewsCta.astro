---
import Icon from '../Icon.astro';
import { business } from '../../lib/business';
---

{/*
  Placeholder testimonials were removed for E-E-A-T. Link to real Google reviews
  until the shop supplies repair-specific quotes we can publish on-site.
*/}
<section class="bg-paper py-20 sm:py-28">
  <div class="container-shop max-w-2xl">
    <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      See what locals say on Google.
    </h2>
    <p class="mt-3 text-steel-700">
      We keep customer feedback on our Google Business Profile so you can read recent, verified reviews — not recycled quotes.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={business.socials.google}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-12 touch-manipulation items-center justify-center gap-2 rounded-control bg-ink px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-ink-soft"
      >
        <Icon name="star" class="size-4" />
        Read Google reviews
      </a>
      <a
        href="/quote"
        class="inline-flex min-h-12 touch-manipulation items-center justify-center gap-2 rounded-control border border-ink/15 px-5 py-3 text-sm font-semibold text-ink hover:bg-steel-100"
      >
        Get a free quote
      </a>
    </div>
  </div>
</section>
