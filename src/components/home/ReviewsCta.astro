---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { business } from '../../lib/business';
import bgReviews from '../../assets/images/bg-reviews.jpg';
---

{/*
  Placeholder testimonials were removed for E-E-A-T. Link to real Google reviews
  until the shop supplies repair-specific quotes we can publish on-site.
*/}
<section class="relative overflow-hidden bg-ink py-20 text-white sm:py-28">
  <div class="absolute inset-0">
    <Image
      src={bgReviews}
      alt=""
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      class="size-full object-cover object-[center_40%]"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-ink/78" aria-hidden="true"></div>
  </div>

  <div data-reveal class="relative container-shop max-w-2xl">
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
      See what locals say on Google.
    </h2>
    <p class="mt-3 text-steel-300">
      We keep customer feedback on our Google Business Profile so you can read recent, verified reviews - not recycled quotes.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={business.socials.google}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        <Icon name="star" class="size-4" />
        Read Google reviews
      </a>
      <a
        href="/book"
        data-contact-action="schedule"
        data-contact-location="reviews-cta"
        class="btn btn-on-dark"
      >
        <Icon name="calendar-check" class="size-4" />
        Schedule Appointment
      </a>
    </div>
  </div>
</section>
