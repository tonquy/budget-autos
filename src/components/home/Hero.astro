---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import ContactActions from '../ContactActions.astro';
import heroImage from '../../assets/images/hero-home.jpg';
import { business } from '../../lib/business';

interface Props {
  /** Optional H1 first line - defaults to homepage copy */
  titleLine1?: string;
  /** Optional H1 second line */
  titleLine2?: string;
  /**
   * Only the /locations/[city] SEO pages pass these. They carry local keywords,
   * so they stay in the DOM for crawlers, but they are hidden on mobile to keep
   * the first screen down to one message and one action. The homepage passes
   * neither and stays minimal at every width.
   */
  description?: string;
  eyebrow?: string;
  imageAlt?: string;
}

const {
  titleLine1 = 'Your car, fixed right',
  titleLine2 = 'No surprises on the bill.',
  description,
  eyebrow,
  imageAlt = `Open bay and vehicle on a lift at ${business.name} in ${business.address.city}`,
} = Astro.props;
---

{/*
  One photo, one message, one action. Nothing else.

  The hero is the first thing a visitor sees, usually on a phone, usually
  because something is wrong with their car. Everything that is not the
  headline or the single conversion action has been moved below the fold:
  the eyebrow (the header already carries the logo), the support paragraph
  (it repeats what the sections below say), and the secondary links.

  Mobile centres the composition and runs near full height. Desktop keeps the
  left-aligned composition because the photo's subject sits on the right.
*/}
<section
  class="hero relative flex min-h-[62dvh] items-center overflow-hidden bg-ink text-white sm:min-h-[min(72dvh,36rem)] lg:min-h-[min(76dvh,40rem)]"
>
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt={imageAlt}
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-image size-full object-cover object-[center_45%]"
    />
    {/* Light, even scrim on mobile so the copy stays legible without turning
        the shop photo into a grey slab. Desktop keeps the side-gradient. */}
    <div class="absolute inset-0 bg-ink/35 sm:bg-transparent" aria-hidden="true"></div>
    <div
      class="absolute inset-0 bg-linear-to-t from-ink/88 via-ink/45 to-ink/25 sm:bg-linear-to-r sm:from-ink/88 sm:via-ink/45 sm:to-ink/20"
      aria-hidden="true"
    ></div>
  </div>

  <div class="relative container-shop w-full pb-20 pt-16 sm:pb-14 sm:pt-20 lg:pb-16">
    <div class="hero-copy mx-auto max-w-lg text-center sm:mx-0 sm:max-w-xl sm:text-left lg:max-w-2xl">
      {
        eyebrow && (
          <p class="mb-2.5 hidden font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent sm:block">
            {eyebrow}
          </p>
        )
      }

      {/* Mobile shows one line only. The second line does not fit on a 390px
          screen at hero scale without breaking to three ragged lines, and one
          strong line converts better than three cramped ones. */}
      <h1
        class="font-display text-[2rem] font-bold leading-[1.06] text-white sm:text-4xl lg:text-5xl"
      >
        {titleLine1}<span class="text-accent">.</span>
        <span class="mt-1 hidden text-white/90 sm:block">{titleLine2}</span>
      </h1>

      {
        description && (
          <p class="mt-5 hidden max-w-md text-base leading-relaxed text-steel-200 sm:block">
            {description}
          </p>
        )
      }

      {/*
        Mobile carries the contact choices here, because the header collapses to
        a hamburger on small screens so nothing else on the first view offers a
        way to reach the shop. The sticky bottom bar stays tucked away while this
        hero is on screen so the same actions never appear twice.
      */}
      <div data-hero-actions class="mt-8 md:hidden">
        <ContactActions tone="dark" location="home-hero" />

        {/* Booking gets its own full-width row beneath the instant-contact pair
            rather than becoming a third cell in their grid: it is the action
            this page is built around and it needs the width to read that way.
            Most of this shop's traffic is phones, so it cannot be desktop-only. */}
        <a
          href="/book"
          data-contact-action="schedule"
          data-contact-location="home-hero"
          class="btn btn-on-dark mt-2.5 w-full"
        >
          <Icon name="calendar-check" class="size-4 shrink-0" />
          Schedule Appointment
        </a>
      </div>

      {/*
        Desktop keeps Call/Text in the header, so they are not repeated here,
        which leaves booking as the single action on the first screen. It links
        straight to /book - the flow opens on service selection, so routing
        through /services first would only add a step to the same choice.
      */}
      <div class="mt-9 hidden flex-wrap items-center gap-3 md:flex">
        <a
          href="/book"
          data-contact-action="schedule"
          data-contact-location="home-hero"
          class="btn btn-lg btn-primary"
        >
          Schedule Appointment
          <Icon name="calendar-check" class="size-4" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-image {
    animation: hero-ken 16s ease-out forwards;
  }

  .hero-copy {
    animation: hero-rise 0.85s cubic-bezier(0.32, 0.72, 0, 1) both;
  }

  @keyframes hero-ken {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image,
    .hero-copy {
      animation: none;
    }
  }
</style>
