---
import Icon from '../Icon.astro';
import { business } from '../../lib/business';

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(business.mapsQuery)}`;
---

<section id="location" class="border-t border-black/5 bg-surface py-12 sm:py-16">
  <div data-reveal class="container-shop grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-8">
    <div>
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Come see us.
      </h2>

      <div class="mt-8 space-y-5">
        <div class="flex items-start gap-3">
          <Icon name="map-pin" class="mt-0.5 size-5 shrink-0 text-accent" />
          <div>
            <p class="font-semibold text-ink">{business.address.line1}</p>
            <p class="text-steel-700">{business.address.city}, {business.address.state} {business.address.zip}</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-accent" />
          <div class="space-y-1">
            {business.hours.map((h) => (
              <p class="flex gap-4 text-steel-700">
                <span class="w-32 font-medium text-ink">{h.day}</span>
                <span>{h.time}</span>
              </p>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ink"
        >
          <Icon name="navigation" class="size-4" />
          Get Directions
        </a>
        <a
          href="/locations/"
          class="btn btn-secondary"
        >
          Service areas
        </a>
      </div>
    </div>

    <div class="grid gap-4">
      <div class="overflow-hidden rounded-card border border-black/5 shadow-card">
        <iframe
          title={`Map to ${business.name}`}
          src={business.mapsEmbedSrc}
          class="h-64 w-full lg:h-72"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
