---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { business } from '../../lib/business';
import shopExterior from '../../assets/images/hero-locations.jpg';
import registeredSign from '../../assets/images/registered-sign.jpg';
import { registrationImageCaption } from '../../lib/seo';

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(business.mapsQuery)}`;
---

<section id="location" class="border-t border-black/5 bg-surface py-20 sm:py-28">
  <div data-reveal class="container-shop grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-8">
    <div>
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Come see us.
      </h2>
      <p class="mt-3 text-steel-700">
        Right on {business.address.line1} in {business.address.city} - easy in-and-out for Binghamton, Endicott, Vestal, Endwell, and nearby towns. Room to leave your car overnight if you need to.
      </p>

      <div class="mt-8 space-y-5">
        <div class="flex items-start gap-3">
          <Icon name="map-pin" class="mt-0.5 size-5 shrink-0 text-accent" />
          <div>
            <p class="font-semibold text-ink">{business.address.line1}</p>
            <p class="text-steel-700">{business.address.city}, {business.address.state} {business.address.zip}</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-accent" />
          <div class="space-y-1">
            {business.hours.map((h) => (
              <p class="flex gap-4 text-steel-700">
                <span class="w-32 font-medium text-ink">{h.day}</span>
                <span>{h.time}</span>
              </p>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ink"
        >
          <Icon name="navigation" class="size-4" />
          Get Directions
        </a>
        <a
          href="/locations/"
          class="btn btn-secondary"
        >
          Service areas
        </a>
      </div>
    </div>

    <div class="grid gap-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="overflow-hidden rounded-card border border-black/5 shadow-card">
          <Image
            src={shopExterior}
            alt={`Shop exterior vibe near ${business.address.city} - Budget Autos Repair is on Airport Rd`}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            class="aspect-4/3 w-full object-cover object-[center_60%]"
          />
        </div>
        {/*
          The NYS DMV registration sign posted at the shop. Every shop that
          repairs cars for pay in New York has to hold this registration, so it
          is the plainest proof this is a real, regulated repair facility. The
          same photo is on the Google Business Profile, and the caption keeps
          the registration number in crawlable text next to the address.
        */}
        <figure class="overflow-hidden rounded-card border border-black/5 bg-paper shadow-card">
          <Image
            src={registeredSign}
            alt={registrationImageCaption()}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            class="aspect-4/3 w-full object-cover"
          />
          <figcaption class="flex items-start gap-2 px-4 py-3 text-xs leading-relaxed text-steel-700">
            <Icon name="badge-check" class="mt-0.5 size-4 shrink-0 text-accent" />
            <span>
              {business.registration.label}, No. {business.registration.number}.
            </span>
          </figcaption>
        </figure>
      </div>
      <div class="overflow-hidden rounded-card border border-black/5 shadow-card">
        <iframe
          title={`Map to ${business.name}`}
          src={business.mapsEmbedSrc}
          class="h-64 w-full lg:h-72"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
