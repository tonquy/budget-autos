---
import Icon from '../Icon.astro';
import { business } from '../../lib/business';
---

<section class="hero video-hero" aria-labelledby="home-heading">
  <div class="hero-media" aria-hidden="true">
    <picture>
      <source media="(max-width: 767px)" srcset="/videos/hero-mobile-poster.jpg" />
      <img src="/videos/hero-desktop-poster.jpg" alt="" fetchpriority="high" width="1600" height="900" />
    </picture>
    <video id="hero-video" muted loop playsinline preload="none" tabindex="-1"></video>
  </div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-content container-shop">
    <p class="hero-eyebrow">Family-owned. Since {business.foundedYear}.</p>
    <h1 id="home-heading">Best auto repair in<br />Johnson City, NY.</h1>
    <p class="hero-description">From check-engine lights to brakes and everyday maintenance, we help you understand what your car needs—and what it will cost before the work begins.</p>
    <div class="hero-actions" data-hero-actions>
      <a href="/quote/" class="btn btn-primary btn-lg" data-contact-action="quote" data-contact-location="home-hero">Get a Quote <Icon name="arrow-up-right" class="size-4" /></a>
      <a href="/book/" class="btn btn-on-dark btn-lg" data-contact-action="schedule" data-contact-location="home-hero">Schedule Appointment <Icon name="calendar-check" class="size-4" /></a>
    </div>
  </div>
</section>

<style>
  .video-hero { position: relative; isolation: isolate; display: grid; place-items: center; min-height: max(42rem, 100dvh); overflow: hidden; background: #17181c; color: white; }
  .hero-media, .hero-veil { position: absolute; inset: 0; z-index: -1; }
  .hero-media img, .hero-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-media video { opacity: 0; transition: opacity .5s ease; }
  .hero-media video.is-playing { opacity: 1; }
  .hero-veil { background: linear-gradient(180deg, rgb(12 18 22 / 55%), rgb(12 18 22 / 62%) 50%, rgb(12 18 22 / 78%)); }
  .hero-content { display: flex; flex-direction: column; align-items: center; padding-block: 8rem 6rem; text-align: center; }
  .hero-eyebrow { margin-bottom: 1.25rem; font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #eee5db; }
  h1 { max-width: 18ch; font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 700; line-height: 1.05; letter-spacing: -.045em; }
  .hero-description { max-width: 33rem; margin-top: 1.5rem; font-size: 1.0625rem; line-height: 1.65; color: #e8e5e1; }
  .hero-actions { display: flex; justify-content: center; gap: .625rem; margin-top: 1.75rem; }
  .hero-actions .btn { min-height: 3rem; padding-inline: 1.25rem; font-size: .875rem; }
  @media (max-width: 767px) {
    .video-hero { min-height: max(40rem, 100dvh); }
    .hero-content { padding-block: 7rem 4rem; }
    h1 { font-size: clamp(2rem, 8.5vw, 2.75rem); }
    .hero-description { font-size: .9375rem; max-width: 34ch; }
    .hero-actions { flex-direction: column; width: min(100%, 17rem); margin-top: 1.75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-media video { transition: none; } }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('#hero-video');
  if (video) {
    const mobile = window.matchMedia('(max-width: 767px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    let pageReady = document.readyState === 'complete';
    function setSource() {
      if (!video || !pageReady) return;
      if (reducedMotion.matches || connection?.saveData || ['slow-2g', '2g', '3g'].includes(connection?.effectiveType ?? '')) {
        video.pause();
        video.removeAttribute('src');
        video.load();
        video.classList.remove('is-playing');
        return;
      }
      video.classList.remove('is-playing');
      video.src = `/videos/budget-autos-hero-${mobile.matches ? 'mobile' : 'desktop'}.mp4`;
      video.load();
      void video.play().catch(() => {});
    }
    video.addEventListener('playing', () => video.classList.add('is-playing'));
    video.addEventListener('error', () => video.classList.remove('is-playing'));
    mobile.addEventListener('change', setSource);
    reducedMotion.addEventListener('change', setSource);
    if (pageReady) setSource();
    else window.addEventListener('load', () => { pageReady = true; setSource(); }, { once: true });
  }
</script>
