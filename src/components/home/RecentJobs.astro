---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import before from '../../assets/images/jobs/before.webp';
import after from '../../assets/images/jobs/after.webp';
import caliper from '../../assets/images/jobs/caliper-detail.webp';
import brake from '../../assets/images/jobs/brake-detail.webp';
import engines from '../../assets/images/jobs/workshop/img-3187.webp';
import engineBay from '../../assets/images/jobs/workshop/img-3188.webp';
import exposedBrake from '../../assets/images/jobs/workshop/img-2923.webp';
import hoodFront from '../../assets/images/jobs/hood-dent/front.webp';
import hoodHeadOn from '../../assets/images/jobs/hood-dent/head-on.webp';
import hoodTop from '../../assets/images/jobs/hood-dent/hood-top.webp';
import hoodEdge from '../../assets/images/jobs/hood-dent/hood-edge.webp';
import hoodClose from '../../assets/images/jobs/hood-dent/hood-close.webp';
import hoodBeforeFront from '../../assets/images/jobs/hood-dent/before-front.webp';
import hoodBeforeClose from '../../assets/images/jobs/hood-dent/before-close.webp';
import hoodBeforeReflection from '../../assets/images/jobs/hood-dent/before-reflection.webp';
import quarterBeforeSide from '../../assets/images/jobs/quarter-dent/before-side.webp';
import quarterBeforeRear from '../../assets/images/jobs/quarter-dent/before-rear.webp';
import quarterAfterSide from '../../assets/images/jobs/quarter-dent/after-side.webp';
import quarterAfterPanel from '../../assets/images/jobs/quarter-dent/after-panel.webp';
import glassBefore1 from '../../assets/images/jobs/window-repair/before1.webp';
import glassBefore2 from '../../assets/images/jobs/window-repair/before2.webp';
import glassBefore3 from '../../assets/images/jobs/window-repair/before3.webp';
import glassBefore4 from '../../assets/images/jobs/window-repair/before4.webp';
import glassAfter1 from '../../assets/images/jobs/window-repair/after1.webp';
import glassAfter2 from '../../assets/images/jobs/window-repair/after2.webp';


/*
  Recent work as a scroll story. Every job is a chapter stacked down the page;
  as each one scrolls into view its title rises, the before photo slides in from
  the left, the after from the right, and the extra photos pop up in turn. A
  sticky rail on desktop tracks which job you are on. Every photo links to its
  full-size copy under /public/jobs/ and opens in the on-page viewer.
*/

type Stage = 'Before' | 'After';
type Photo = {
  image: ImageMetadata;
  href: string;
  stage?: Stage;
  caption: string;
  alt: string;
  focus?: string;
  reading?: string;
};
type Job = {
  id: string;
  tab: string;
  title: string;
  intro: string;
  /** Aspect ratio of the lead before/after pair. */
  ratio: string;
  pair?: [Photo, Photo];
  more: Photo[];
  note?: string;
};

const brakeMedia = '/jobs/electric-brake';
const hoodMedia = '/jobs/hood-dent';
const quarterMedia = '/jobs/quarter-dent';
const glassMedia = '/jobs/window-repair';

const jobs: Job[] = [
  {
    id: 'windshield',
    tab: 'Windshield',
    title: 'Cracked windshield replaced',
    intro: 'This windshield came in with a large crack spreading across the driver’s line of sight. We removed the damaged glass and installed a new windshield.',
    ratio: '4 / 3',
    pair: [
      { image: glassBefore4, href: `${glassMedia}/before4.webp`, stage: 'Before', caption: 'Crack spreading from the impact point', alt: 'View from the driver’s seat before the repair, with cracks radiating across the windshield from a single impact point.' },
      { image: glassAfter1, href: `${glassMedia}/after1.webp`, stage: 'After', caption: 'Clear new glass from the driver’s seat', alt: 'View from the driver’s seat after the repair, looking out through the new, crack-free windshield at night.' },
    ],
    more: [
      { image: glassBefore2, href: `${glassMedia}/before2.webp`, stage: 'Before', caption: 'The impact point from outside', alt: 'Outside view of the cracked windshield before the repair, with lines spreading out from the impact point.' },
      { image: glassAfter2, href: `${glassMedia}/after2.webp`, stage: 'After', caption: 'New windshield installed', alt: 'Black SUV after the repair with its new windshield installed and tape holding the trim at the top edge.' },
      { image: glassBefore1, href: `${glassMedia}/before1.webp`, stage: 'Before', caption: 'Damage across the driver side', alt: 'Outside view of the windshield before the repair, with cracks running across the driver side.' },
      { image: glassBefore3, href: `${glassMedia}/before3.webp`, stage: 'Before', caption: 'Passenger-side view of the old glass', alt: 'Windshield before the repair seen from the passenger side, with trees reflected in the glass.' },
    ],
    note: 'Before and after photographed at the shop.',
  },
  {
    id: 'brakes',
    tab: 'Brakes',
    title: 'Brake drag & overheating',
    intro: 'A brake inspection traced uneven temperatures to seized calipers.',
    ratio: '4 / 5',
    pair: [
      { image: before, href: `${brakeMedia}/before.webp`, stage: 'Before', reading: '396.9°F', caption: 'Thermal reading at the wheel', alt: 'Before repair: thermal camera at the wheel reads 396.9°F.' },
      { image: after, href: `${brakeMedia}/after.webp`, stage: 'After', reading: '119.8°F', caption: 'Thermal reading at the wheel', alt: 'After repair: thermal camera at the wheel reads 119.8°F.' },
    ],
    more: [
      { image: caliper, href: `${brakeMedia}/caliper-detail.webp`, caption: 'Brake caliper close-up', alt: 'Close-up of the brake caliper and pads during the brake inspection.' },
      { image: brake, href: `${brakeMedia}/brake-detail.webp`, caption: 'A second look at the assembly', alt: 'Second view of the brake assembly and pads during the job.' },
    ],
    note: 'Actual readings photographed during this job.',
  },
  {
    id: 'hood-dent',
    tab: 'Hood dent',
    title: 'Hood dent repair',
    intro: 'A Mazda CX-5 came in with a dent in the middle of its hood.',
    ratio: '4 / 3',
    pair: [
      { image: hoodBeforeFront, href: `${hoodMedia}/before-front.webp`, stage: 'Before', focus: 'center 48%', caption: 'Dent in the middle of the hood', alt: 'Red Mazda CX-5 before the repair, with a dent visible in the middle of its dusty hood.' },
      { image: hoodFront, href: `${hoodMedia}/front.webp`, stage: 'After', caption: 'Hood and front end after repair', alt: 'Red Mazda CX-5 photographed from the front corner after the hood dent repair, with a smooth, even hood.' },
    ],
    more: [
      { image: hoodBeforeReflection, href: `${hoodMedia}/before-reflection.webp`, stage: 'Before', focus: 'center 42%', caption: 'Reflection bending around the dent', alt: 'Before the repair: tree and sky reflections twist into a swirl around the dent in the hood.' },
      { image: hoodTop, href: `${hoodMedia}/hood-top.webp`, stage: 'After', focus: 'center 60%', caption: 'Even reflections across the panel', alt: 'Looking down the repaired red hood toward the grille, with clean reflections across the panel.' },
      { image: hoodBeforeClose, href: `${hoodMedia}/before-close.webp`, stage: 'Before', focus: 'center 52%', caption: 'The dent up close', alt: 'Close view of the dent in the red hood before the repair, with dust on the paint around it.' },
      { image: hoodClose, href: `${hoodMedia}/hood-close.webp`, stage: 'After', focus: 'center 60%', caption: 'The same panel up close', alt: 'Close view of the repaired red hood, smooth with unbroken sky reflections.' },
      { image: hoodHeadOn, href: `${hoodMedia}/head-on.webp`, stage: 'After', caption: 'Straight-on view of the finished hood', alt: 'Red Mazda CX-5 photographed head-on after the hood dent repair.' },
      { image: hoodEdge, href: `${hoodMedia}/hood-edge.webp`, stage: 'After', focus: 'center 60%', caption: 'Hood edge and fender gap', alt: 'Close view of the repaired hood edge where it meets the fender, showing an even panel and gap.' },
    ],
    note: 'Before and after photographed in our lot.',
  },
  {
    id: 'quarter-panel',
    tab: 'Quarter panel',
    title: 'Rear quarter panel dent',
    intro: 'A Genesis sedan came in with a dented rear quarter panel and chipped paint beside the trunk lid.',
    ratio: '4 / 5',
    pair: [
      { image: quarterBeforeSide, href: `${quarterMedia}/before-side.webp`, stage: 'Before', caption: 'Dent beside the trunk lid', alt: 'White Genesis sedan before the repair, with a deep dent in the rear quarter panel beside the trunk lid and chipped paint at the corner.' },
      { image: quarterAfterSide, href: `${quarterMedia}/after-side.webp`, stage: 'After', caption: 'Smooth panel down to the tail light', alt: 'White Genesis sedan after the repair, with a smooth rear quarter panel running past the fuel door to the tail light.' },
    ],
    more: [
      { image: quarterBeforeRear, href: `${quarterMedia}/before-rear.webp`, stage: 'Before', caption: 'Creased panel above the tail light', alt: 'White Genesis sedan before the repair, seen from behind, with the quarter panel creased above the tail light.' },
      { image: quarterAfterPanel, href: `${quarterMedia}/after-panel.webp`, stage: 'After', caption: 'Repaired quarter panel and fuel door', alt: 'Close view of the repaired white quarter panel around the fuel door, with even paint above the rear wheel.' },
    ],
    note: 'Before and after photographed in our lot.',
  },
  {
    id: 'workshop',
    tab: 'Workshop',
    title: 'Inside the workshop',
    intro: 'A look at the bays and the work in progress.',
    ratio: '3 / 4',
    more: [
      { image: engines, href: '/jobs/workshop/img-3187.webp', caption: 'Engines in the workshop', alt: 'Engine assemblies resting on pallets in the workshop.' },
      { image: engineBay, href: '/jobs/workshop/img-3188.webp', caption: 'Inside the engine bay', alt: 'Engine bay with the engine removed and the transmission visible.' },
      { image: exposedBrake, href: '/jobs/workshop/img-2923.webp', caption: 'A closer look at the brakes', alt: 'Brake caliper and rotor exposed with the wheel removed.' },
    ],
  },
];

const workshopVideos = [
  { file: 'img-3189', caption: 'Engine bay walkthrough' },
  { file: 'img-2918', caption: 'Brake assembly close-up' },
];

const openLabel = (photo: Photo) =>
  `View larger: ${photo.stage ? `${photo.stage.toLowerCase()}, ` : ''}${photo.caption.toLowerCase()}`;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="recent-jobs" class="recent-work" aria-labelledby="recent-jobs-title">
  <div class="container-shop">
    <div class="jobs-heading">
      <p class="eyebrow">From our bays</p>
      <h2 id="recent-jobs-title" class="font-display">Recent work.</h2>
      <p class="lede">Real cars, real repairs. Keep scrolling to see each one before and after.</p>
    </div>

    <div class="flow" data-flow>
      {/* Desktop chapter rail: sticks beside the jobs and tracks where you are. */}
      <nav class="rail" aria-label="Jump to a job">
        <ol>
          {jobs.map((job, i) => (
            <li>
              <a href={`#job-${job.id}`} data-rail={job.id}>
                <span class="rail-num">{pad(i + 1)}</span>
                <span>{job.tab}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="chapters">
        {jobs.map((job, i) => (
          <article
            class:list={['chapter', job.ratio === '4 / 5' && 'is-portrait', !job.pair && 'is-gallery']}
            id={`job-${job.id}`}
            data-chapter={job.id}
            style={`--pair-ratio: ${job.ratio}`}
            aria-labelledby={`job-title-${job.id}`}
          >
            <header class="chapter-head">
              <p class="chapter-kicker"><span>{pad(i + 1)}</span> / {pad(jobs.length)} · {job.tab}</p>
              <h3 id={`job-title-${job.id}`} class="font-display">{job.title}</h3>
              <p>{job.intro}</p>
            </header>

            {job.pair && (
              <div class="pair">
                {job.pair.map((photo, p) => (
                  <figure class:list={['pair-photo', p === 0 ? 'from-left' : 'from-right']}>
                    <a href={photo.href} data-zoom data-caption={photo.caption} data-stage={photo.stage} aria-label={openLabel(photo)}>
                      <Image src={photo.image} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 340px, 46vw" quality={75} alt={photo.alt} style={photo.focus ? `object-position: ${photo.focus}` : undefined} loading="lazy" decoding="async" />
                      <span class:list={['stage', photo.stage === 'After' && 'is-after']}>{photo.stage}</span>
                    </a>
                    <figcaption>
                      {photo.reading && <strong class:list={['reading', photo.stage === 'After' && 'is-after']}>{photo.reading}</strong>}
                      {photo.caption}
                    </figcaption>
                  </figure>
                ))}
                <span class="pair-arrow" aria-hidden="true">→</span>
              </div>
            )}

            {job.more.length > 0 && (
              <div class="more">
                {job.pair && <p class="more-label">More from this job</p>}
                <ul>
                  {job.more.map((photo, m) => (
                    <li style={`--i: ${m}`}>
                      <a href={photo.href} data-zoom data-caption={photo.caption} data-stage={photo.stage} aria-label={openLabel(photo)} title={photo.caption}>
                        <Image src={photo.image} widths={[160, 240, 360, 480]} sizes={job.pair ? '(min-width: 1024px) 120px, 30vw' : '(min-width: 1024px) 230px, 32vw'} quality={70} alt={photo.alt} style={photo.focus ? `object-position: ${photo.focus}` : undefined} loading="lazy" decoding="async" />
                        {photo.stage && <span class:list={['stage', photo.stage === 'After' && 'is-after']}>{photo.stage}</span>}
                      </a>
                      {!job.pair && <p class="thumb-caption">{photo.caption}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {job.id === 'brakes' && (
              <details class="job-details">
                <summary>Inspection notes &amp; footage <span aria-hidden="true">+</span></summary>
                <div class="technician-notes">
                  <h4>What we found</h4>
                  <p>The customer reported shaking, possible brake overheating and one instance of stalling. We scanned the vehicle, cleared stored parking-brake codes linked to earlier low voltage, and road-tested it. The test did not reproduce the stalling or excessive shaking, and no warning lights were active.</p>
                  <p>Front and rear brake readings were <strong>316–327°F on the driver side</strong> and <strong>396–416°F on the passenger side</strong>, where seized calipers were causing brake drag.</p>
                  <h4>Recommended service</h4>
                  <ul>
                    <li><strong>Required:</strong> Replace both front calipers to correct binding.</li>
                    <li><strong>Recommended:</strong> Replace pads and rotors at all four wheels to address pulsation and promote even wear.</li>
                    <li><strong>Recommended:</strong> Clean and inspect the rear calipers; replacement was advised because they showed signs of drag.</li>
                  </ul>
                </div>
                <div class="video-grid is-single">
                  <figure>
                    <video controls muted playsinline preload="none" width="720" height="1280" poster={`${brakeMedia}/video-poster.webp`} aria-label="Brake inspection video, no audio">
                      <source src={`${brakeMedia}/inspection.mp4`} type="video/mp4" />
                      <a href={`${brakeMedia}/inspection.mp4`}>Download the inspection video</a>.
                    </video>
                    <figcaption>Inspection footage · <a href={`${brakeMedia}/inspection.mp4`} download>Download MP4</a></figcaption>
                  </figure>
                </div>
              </details>
            )}

            {job.id === 'workshop' && (
              <details class="job-details">
                <summary>Watch workshop videos <span aria-hidden="true">+</span></summary>
                <div class="video-grid">
                  {workshopVideos.map((video) => (
                    <figure>
                      <video controls muted playsinline preload="none" width="720" height="1280" poster={`/jobs/workshop/${video.file}-poster.webp`} aria-label={`${video.caption}, no audio`}>
                        <source src={`/jobs/workshop/${video.file}-silent.mp4`} type="video/mp4" />
                        <a href={`/jobs/workshop/${video.file}-silent.mp4`}>Download the video</a>.
                      </video>
                      <figcaption>{video.caption} · <a href={`/jobs/workshop/${video.file}-silent.mp4`} download>Download MP4</a></figcaption>
                    </figure>
                  ))}
                </div>
              </details>
            )}

            {job.note && <p class="photo-note">{job.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </div>

  {/* Photo viewer. Filled in by the script below; the links keep their href so
      the full-size photo still opens if the script never runs. */}
  <dialog class="viewer" data-viewer aria-label="Photo viewer">
    <figure>
      <img data-viewer-img alt="" />
      <figcaption>
        <span class="stage" data-viewer-stage hidden></span>
        <span data-viewer-caption></span>
        <span class="viewer-count" data-viewer-count></span>
      </figcaption>
    </figure>
    <button type="button" class="viewer-btn viewer-close" data-viewer-close aria-label="Close photo">✕</button>
    <button type="button" class="viewer-btn viewer-prev" data-viewer-prev aria-label="Previous photo">‹</button>
    <button type="button" class="viewer-btn viewer-next" data-viewer-next aria-label="Next photo">›</button>
  </dialog>
</section>

<script>
  // Scroll story: each job "plays" once as it scrolls into view (title rises,
  // before slides in from the left, after from the right, extra photos pop up).
  // Content is visible by default; the hidden starting pose is only armed once
  // this script runs, so a failed script never leaves the section blank.
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((flow) => {
    const chapters = Array.from(flow.querySelectorAll<HTMLElement>('[data-chapter]'));
    const railLinks = new Map(
      Array.from(flow.querySelectorAll<HTMLAnchorElement>('[data-rail]')).map((a) => [a.dataset.rail, a]),
    );
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window)) return;

    if (!reduceMotion) {
      flow.classList.add('is-armed');
      const play = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            play.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -18% 0px', threshold: 0.12 },
      );
      chapters.forEach((c) => play.observe(c));
    }

    // Rail highlight: whichever chapter crosses the middle band of the screen.
    const track = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = (entry.target as HTMLElement).dataset.chapter;
          railLinks.forEach((link, key) => {
            if (key === id) link.setAttribute('aria-current', 'step');
            else link.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    chapters.forEach((c) => track.observe(c));
  });

  // Photo viewer: clicking a photo enlarges it in place. Arrows (buttons, keys
  // or a swipe) step through the photos of the same job; Esc, ✕ or a click on
  // the dark backdrop closes it.
  const viewer = document.querySelector<HTMLDialogElement>('[data-viewer]');
  if (viewer && typeof viewer.showModal === 'function') {
    const img = viewer.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const stage = viewer.querySelector<HTMLElement>('[data-viewer-stage]')!;
    const caption = viewer.querySelector<HTMLElement>('[data-viewer-caption]')!;
    const count = viewer.querySelector<HTMLElement>('[data-viewer-count]')!;
    const prev = viewer.querySelector<HTMLButtonElement>('[data-viewer-prev]')!;
    const next = viewer.querySelector<HTMLButtonElement>('[data-viewer-next]')!;
    let group: HTMLAnchorElement[] = [];
    let index = 0;

    function show(i: number) {
      index = (i + group.length) % group.length;
      const link = group[index];
      const thumb = link.querySelector('img');
      img.src = link.href;
      img.alt = thumb?.alt ?? '';
      caption.textContent = link.dataset.caption ?? '';
      const label = link.dataset.stage ?? '';
      stage.textContent = label;
      stage.hidden = !label;
      stage.classList.toggle('is-after', label === 'After');
      count.textContent = group.length > 1 ? `${index + 1} / ${group.length}` : '';
      prev.hidden = next.hidden = group.length < 2;
    }

    document.querySelectorAll<HTMLAnchorElement>('[data-zoom]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const chapter = link.closest('.chapter') ?? document;
        group = Array.from(chapter.querySelectorAll<HTMLAnchorElement>('[data-zoom]'));
        show(group.indexOf(link));
        viewer.showModal();
      });
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    viewer.querySelector('[data-viewer-close]')!.addEventListener('click', () => viewer.close());
    // A click that lands on the dialog itself (not the photo or buttons) is the backdrop.
    viewer.addEventListener('click', (event) => {
      if (event.target === viewer) viewer.close();
    });
    viewer.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    viewer.addEventListener('close', () => img.removeAttribute('src'));

    let startX = 0;
    viewer.addEventListener('touchstart', (event) => { startX = event.touches[0].clientX; }, { passive: true });
    viewer.addEventListener('touchend', (event) => {
      const dx = event.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50 && group.length > 1) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .recent-work { padding-block: clamp(4rem, 8vw, 7rem); background: var(--color-surface); }
  img { display: block; width: 100%; height: auto; }

  /* Heading */
  .jobs-heading { max-width: 40rem; margin-inline: auto; text-align: center; }
  .eyebrow { color: var(--color-accent-dark); font-size: .75rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .jobs-heading h2 { margin-top: .5rem; font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 700; line-height: 1.02; letter-spacing: -.035em; }
  .lede { margin-top: .875rem; color: var(--color-steel-700); font-size: 1.0625rem; line-height: 1.55; }

  /* Layout: sticky rail + chapters on desktop, chapters only on phones. */
  .flow { max-width: 68rem; margin: clamp(2.5rem, 5vw, 4rem) auto 0; }
  .rail { display: none; }
  @media (min-width: 1024px) {
    .flow { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 3.5rem; }
    .rail { display: block; position: sticky; top: 7rem; align-self: start; }
    .rail ol { position: relative; display: grid; gap: .25rem; padding-left: 1rem; border-left: 1px solid var(--color-steel-200); }
    .rail a { position: relative; display: flex; align-items: baseline; gap: .75rem; padding: .5rem 0; color: var(--color-steel-500); font-size: .9375rem; font-weight: 600; transition: color .3s var(--ease-out-expo); }
    .rail a::before { content: ''; position: absolute; left: calc(-1rem - 1px); top: .35rem; bottom: .35rem; width: 2px; background: var(--color-ink); transform: scaleY(0); transition: transform .4s var(--ease-out-expo); }
    .rail a:hover { color: var(--color-ink); }
    .rail a[aria-current] { color: var(--color-ink); }
    .rail a[aria-current]::before { transform: scaleY(1); }
    .rail-num { font-family: var(--font-display); font-size: .75rem; font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  }

  /* Chapters */
  .chapters { display: grid; gap: clamp(4.5rem, 10vw, 8rem); }
  .chapter { scroll-margin-top: 6rem; }
  .chapter-kicker { color: var(--color-steel-500); font-family: var(--font-display); font-size: .8125rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  .chapter-kicker span { color: var(--color-accent-dark); }
  .chapter-head h3 { margin-top: .5rem; font-size: clamp(1.75rem, 3.6vw, 2.5rem); font-weight: 700; line-height: 1.08; letter-spacing: -.03em; }
  .chapter-head > p:last-child { max-width: 36rem; margin-top: .75rem; color: var(--color-steel-700); font-size: 1rem; line-height: 1.6; }

  /* Before/after pair, always side by side. */
  .pair { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(.625rem, 2vw, 1.25rem); margin-top: clamp(1.5rem, 3vw, 2.25rem); }
  .chapter.is-portrait .pair { max-width: 40rem; }
  .pair-photo a, .more a { position: relative; display: block; overflow: hidden; border-radius: var(--radius-card); background: var(--color-steel-100); cursor: zoom-in; }
  .pair-photo img { aspect-ratio: var(--pair-ratio); object-fit: cover; transition: transform .6s var(--ease-out-expo); }
