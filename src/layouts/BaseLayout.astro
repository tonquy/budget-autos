---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ChatWidget from '../components/chat/ChatWidget';
import { pageTitle, localBusinessJsonLd, OG_IMAGE } from '../lib/seo';
import { business } from '../lib/business';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** e.g. "noindex, nofollow" for thank-you and other non-indexable pages */
  robots?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** Extra JSON-LD graphs (FAQ, Service, BreadcrumbList) merged after AutoRepair */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = OG_IMAGE.path,
  robots,
  ogType = 'website',
  publishedTime,
  jsonLd: extraJsonLd = [],
} = Astro.props;

const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImageUrl = new URL(image, Astro.site ?? Astro.url).toString();
const jsonLdBlocks = [localBusinessJsonLd(siteUrl), ...extraJsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C68F0QVFXR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-C68F0QVFXR');
    </script>

    <link rel="icon" href={`${siteUrl}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${siteUrl}/favicon-192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${siteUrl}/budgetautos-favicon.png`} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle(title)}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:site_name" content={business.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle(title)} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#17181c" />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}

    <!-- Meta Pixel Code -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '754455908780147');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=754455908780147&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body class="bg-paper text-ink antialiased">
    <div class="page-grain" aria-hidden="true"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    {/* Secondary help channel only. The three contact buttons are the front door. */}
    <ChatWidget client:idle />

    <script>
      // Scroll reveals. IntersectionObserver only - never a scroll listener,
      // which would run work on every frame. Elements are authored visible and
      // only armed here, so if this script never runs the page still reads.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (revealTargets.length > 0 && !reduceMotion && 'IntersectionObserver' in window) {
        revealTargets.forEach((el) => {
          el.classList.add('reveal-ready');
          if (el.dataset.reveal === 'stagger') {
            el.classList.add('reveal-stagger');
            Array.from(el.children).forEach((child, i) => {
              (child as HTMLElement).style.setProperty('--reveal-i', String(i));
            });
          }
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
        );

        revealTargets.forEach((el) => observer.observe(el));
      }

      // Prefill the SMS deep link and report the three contact actions to GA4 +
      // Meta, so the shop can see whether calls, texts and service requests
      // actually go up. Runs once per page for every ContactActions instance.
      const SMS_LINKS = document.querySelectorAll<HTMLAnchorElement>('[data-sms-link]');
      // iOS uses `&body=` after the number; Android/everything else uses `?body=`.
      const isIos = /iP(hone|ad|od)|Macintosh.*Version.*Safari/.test(navigator.userAgent) &&
        'ontouchend' in document;
      const separator = isIos ? '&' : '?';

      SMS_LINKS.forEach((link) => {
        const number = link.dataset.smsNumber;
        const body = link.dataset.smsBody;
        if (!number || !body) return;
        link.href = `sms:${number}${separator}body=${encodeURIComponent(body)}`;
      });

      const EVENT_NAMES: Record<string, string> = {
        text: 'contact_text',
        call: 'contact_call',
        request: 'contact_request_online',
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const action = target.closest<HTMLElement>('[data-contact-action]');
        if (!action) return;

        const kind = action.dataset.contactAction ?? '';
        const eventName = EVENT_NAMES[kind];
        if (!eventName) return;

        const params = { placement: action.dataset.contactLocation ?? 'unknown' };
        (window as any).gtag?.('event', eventName, params);
        (window as any).fbq?.('trackCustom', eventName, params);
      });
    </script>
  </body>
</html>
