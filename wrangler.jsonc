{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-20",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "budget-autos",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Prerendered HTML is served as static assets. Cloudflare's default is
		// assets-first, which skips Astro middleware — so the www → apex 301
		// never ran on the homepage and other static pages. Worker-first makes
		// those requests hit middleware before the HTML is served.
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	// Stores customer-uploaded quote photos. `wrangler r2 bucket create budget-auto-repair-quote-photos`
	// creates the real bucket before the first production deploy; local dev uses an emulated bucket automatically.
	"r2_buckets": [
		{
			"binding": "QUOTE_PHOTOS",
			"bucket_name": "budget-auto-repair-quote-photos"
		}
	],
	// Non-secret configuration. Secrets (RESEND_API_KEY, TURNSTILE_SECRET, GEMINI_API_KEY,
	// CAL_API_KEY) live in .dev.vars locally and are set with `wrangler secret put <NAME>`
	// in production - never here.
	//
	// LIVE: leads land in the shop inbox, sent from the verified budgetautosrepair.com
	// domain in Resend. OWNER_NOTIFICATION_EMAIL is where quote + chat leads go;
	// QUOTE_FROM_EMAIL is the verified sender address (must be on a Resend-verified domain).
	// The RESEND_API_KEY secret is set separately via `wrangler secret put RESEND_API_KEY`.
	//
	// CAL_USERNAME is the Cal.com account that owns the per-service event types the
	// /book flow reserves against. See docs/BOOKING_SETUP.md.
	"vars": {
		"OWNER_NOTIFICATION_EMAIL": "info@budgetautosrepair.com",
		"QUOTE_FROM_EMAIL": "info@budgetautosrepair.com",
		"CAL_USERNAME": "budget-auto-repair"
	}
}