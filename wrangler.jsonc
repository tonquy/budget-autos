{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-20",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "budget-autos",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Stores customer-uploaded quote photos. `wrangler r2 bucket create budget-auto-repair-quote-photos`
	// creates the real bucket before the first production deploy; local dev uses an emulated bucket automatically.
	"r2_buckets": [
		{
			"binding": "QUOTE_PHOTOS",
			"bucket_name": "budget-auto-repair-quote-photos"
		}
	],
	// Non-secret configuration. Secrets (RESEND_API_KEY, TURNSTILE_SECRET, GEMINI_API_KEY) live in
	// .dev.vars locally and are set with `wrangler secret put <NAME>` in production - never here.
	//
	// TESTING: OWNER_NOTIFICATION_EMAIL is temporarily set to a test inbox so we can verify
	// the quote form end-to-end. QUOTE_FROM_EMAIL uses Resend's shared sandbox sender
	// (onboarding@resend.dev), which works immediately with any Resend account - no domain
	// verification needed. Swap both to the real owner email and a verified sending domain
	// before this goes live for the client.
	"vars": {
		"OWNER_NOTIFICATION_EMAIL": "tonquy11@gmail.com",
		"QUOTE_FROM_EMAIL": "onboarding@resend.dev"
	}
}