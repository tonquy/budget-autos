# Copy to .env for local development.
# Public Cloudflare Turnstile site key (safe to expose in the browser).
# This is the real widget key; the matching secret lives in .dev.vars as TURNSTILE_SECRET.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD7eom-KB1HZ1Qex

# For local form testing, use Cloudflare's "always passes" TEST pair instead.
# Site key and secret must both be test keys - a production site key checked
# against the test secret in .dev.vars fails, and every form submit comes back
# as "Verification failed".
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   (here)
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA (in .dev.vars)
